<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soft blue glow shadow layer -->
    <item
        android:left="0dp"
        android:top="0dp"
        android:right="0dp"
        android:bottom="0dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#330066FF" />
        </shape>
    </item>

    <!-- Pure white card body with semi-transparent white outer ring -->
    <item
        android:left="4dp"
        android:top="4dp"
        android:right="4dp"
        android:bottom="4dp">
        <shape android:shape="rectangle">
            <corners android:radius="28dp" />
            <solid android:color="#FFFFFF" />
            <stroke
                android:width="6dp"
                android:color="#99FFFFFF" />
        </shape>
    </item>

</layer-list>

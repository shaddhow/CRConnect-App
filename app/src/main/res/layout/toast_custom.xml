<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/toastRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_toast_custom_card"
    android:elevation="20dp"
    android:outlineSpotShadowColor="#8C000000"
    android:outlineAmbientShadowColor="#8C000000"
    android:clipToPadding="false"
    android:clipChildren="false"
    android:clickable="true"
    android:focusable="true"
    tools:targetApi="p">

    <!-- Toast Content Container: Horizontal, Center-Aligned, 12dp Padding, 12dp Gap -->
    <LinearLayout
        android:id="@+id/toastContentLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp"
        android:baselineAligned="false">

        <!-- 1. Icon Container (42x42dp, 12dp Corner Radius) -->
        <FrameLayout
            android:id="@+id/iconContainer"
            android:layout_width="42dp"
            android:layout_height="42dp"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_toast_icon_container">

            <ImageView
                android:id="@+id/toastIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_toast_check"
                app:tint="#4ADE80"
                tools:tint="#4ADE80" />
        </FrameLayout>

        <!-- 2. Text Block (weight=1, fill remaining space, 2dp gap between title & body) -->
        <LinearLayout
            android:id="@+id/textBlock"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:layout_marginEnd="12dp"
            android:orientation="vertical">

            <TextView
                android:id="@+id/toastTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:textFontWeight="600"
                android:textStyle="bold"
                android:textColor="#86EFAC"
                android:textSize="13sp"
                android:maxLines="1"
                android:ellipsize="end"
                tools:targetApi="p"
                tools:text="Published to dashboard" />

            <TextView
                android:id="@+id/toastBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:fontFamily="sans-serif"
                android:textStyle="normal"
                android:textColor="#4A6080"
                android:textSize="11.5sp"
                android:maxLines="3"
                android:ellipsize="end"
                tools:text="shaddhow is now visible to voters" />
        </LinearLayout>

        <!-- 3. Close Button (26x26dp, 7dp Corner Radius, Top Aligned) -->
        <FrameLayout
            android:id="@+id/toastCloseBtn"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top"
            android:layout_marginTop="1dp"
            android:background="@drawable/bg_toast_close_btn"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:id="@+id/toastCloseIcon"
                android:layout_width="14dp"
                android:layout_height="14dp"
                android:layout_gravity="center"
                android:contentDescription="@null"
                android:src="@drawable/ic_toast_close"
                app:tint="#2D4060"
                tools:tint="#2D4060" />
        </FrameLayout>
    </LinearLayout>

    <!-- 4. Progress Bar (Absolute Position: bottom=0, left=0, height=2.5dp) -->
    <View
        android:id="@+id/toastProgressBar"
        android:layout_width="match_parent"
        android:layout_height="2.5dp"
        android:layout_gravity="bottom"
        android:background="@drawable/bg_toast_progress_bar" />

</FrameLayout>

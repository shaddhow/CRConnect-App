<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardLiveElectionControls"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:hapticFeedbackEnabled="true"
    app:cardBackgroundColor="#CC161B22"
    app:cardCornerRadius="20dp"
    app:cardElevation="8dp"
    app:strokeColor="#26FFFFFF"
    app:strokeWidth="1.5dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Row: Title & Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Glass Badge Icon Container -->
                <FrameLayout
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:background="@drawable/glass_badge_bg"
                    android:layout_marginEnd="10dp">
                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:layout_gravity="center"
                        android:src="@android:drawable/ic_menu_recent_history"
                        app:tint="#D8B4FE" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live Election Control"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAdminTimerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/glass_badge_bg"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="CLOSED"
                android:textColor="#9CA3AF"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Compact Countdown Timer Display Box with Glass Background -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/glass_card_bg"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="16dp">

            <TextView
                android:id="@+id/tvAdminTimerDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:letterSpacing="0.04"
                android:text="00:00"
                android:textAlignment="center"
                android:textColor="#FFFFFF"
                android:textSize="36sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_horizontal"
                android:text="Remaining Election Time"
                android:textAlignment="center"
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Adjust Duration Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Adjust Duration"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Adjust Duration Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExtend5Min"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hapticFeedbackEnabled="true"
                android:padding="0dp"
                android:text="+5 Min"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp"
                app:backgroundTint="@drawable/glass_button_bg"
                app:cornerRadius="10dp"
                android:insetBottom="0dp"
                android:insetTop="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExtend10Min"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hapticFeedbackEnabled="true"
                android:padding="0dp"
                android:text="+10 Min"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp"
                app:backgroundTint="@drawable/glass_button_bg"
                app:cornerRadius="10dp"
                android:insetBottom="0dp"
                android:insetTop="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReduce5Min"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_weight="1"
                android:hapticFeedbackEnabled="true"
                android:padding="0dp"
                android:text="-5 Min"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold"
                app:strokeColor="#33FFFFFF"
                app:strokeWidth="1dp"
                app:backgroundTint="@drawable/glass_button_bg"
                app:cornerRadius="10dp"
                android:insetBottom="0dp"
                android:insetTop="0dp" />
        </LinearLayout>

        <!-- Action Buttons Section Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPauseResume"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hapticFeedbackEnabled="true"
                android:padding="0dp"
                android:text="Pause Voting"
                android:textColor="#FBBF24"
                android:textSize="13sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_pause"
                app:iconTint="#FBBF24"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:gravity="center"
                app:strokeColor="#33FBBF24"
                app:strokeWidth="1dp"
                app:backgroundTint="@drawable/glass_button_bg"
                app:cornerRadius="12dp"
                android:insetBottom="0dp"
                android:insetTop="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEndVotingNow"
                android:layout_width="0dp"
                android:layout_height="44dp"
                android:layout_weight="1"
                android:hapticFeedbackEnabled="true"
                android:padding="0dp"
                android:text="End Voting"
                android:textColor="@color/destructive_text"
                android:textSize="13sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_stop"
                app:iconTint="@color/destructive_text"
                app:iconSize="16dp"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:gravity="center"
                app:backgroundTint="@color/destructive_bg"
                app:cornerRadius="12dp"
                android:insetBottom="0dp"
                android:insetTop="0dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

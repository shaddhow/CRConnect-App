<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardLiveElectionControls"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:hapticFeedbackEnabled="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp"
    android:outlineAmbientShadowColor="#14000000"
    android:outlineSpotShadowColor="#14000000"
    tools:ignore="UnusedAttribute">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- Top Header Row: Title & Status Badge -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Icon Badge Container -->
                <FrameLayout
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_icon_badge"
                    android:layout_marginEnd="10dp">
                    <ImageView
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_nav_timer"
                        app:tint="#0066FF" />
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Live election control"
                    android:textColor="#0F172A"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvAdminTimerStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_chip_muted"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="Closed"
                android:textColor="#64748B"
                android:textSize="12sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Countdown Timer Display Box with Light Background -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="16dp"
            android:background="@drawable/bg_timer_box"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingHorizontal="12dp"
            android:paddingVertical="18dp">

            <TextView
                android:id="@+id/tvAdminTimerDisplay"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_horizontal"
                android:letterSpacing="0.02"
                android:fontFeatureSettings="tnum"
                android:text="00:00"
                android:textAlignment="center"
                android:textColor="#0F172A"
                android:textSize="44sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="center_horizontal"
                android:text="Remaining election time"
                android:textAlignment="center"
                android:textColor="#64748B"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Adjust Duration Section Header -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text="Adjust duration"
            android:textColor="#64748B"
            android:textSize="13sp"
            android:textStyle="bold" />

        <!-- Adjust Duration Buttons Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExtend5Min"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hapticFeedbackEnabled="true"
                android:padding="0dp"
                android:text="+5 min"
                android:textAllCaps="false"
                android:textColor="#0066FF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:strokeColor="#0066FF"
                app:strokeWidth="1.5dp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="12dp"
                android:insetBottom="0dp"
                android:insetTop="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnExtend10Min"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hapticFeedbackEnabled="true"
                android:padding="0dp"
                android:text="+10 min"
                android:textAllCaps="false"
                android:textColor="#0066FF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:strokeColor="#0066FF"
                app:strokeWidth="1.5dp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="12dp"
                android:insetBottom="0dp"
                android:insetTop="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnReduce5Min"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hapticFeedbackEnabled="true"
                android:padding="0dp"
                android:text="−5 min"
                android:textAllCaps="false"
                android:textColor="#0066FF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:strokeColor="#0066FF"
                app:strokeWidth="1.5dp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="12dp"
                android:insetBottom="0dp"
                android:insetTop="0dp" />
        </LinearLayout>

        <!-- Action Buttons Section Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:weightSum="2">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPauseResume"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_marginEnd="6dp"
                android:layout_weight="1"
                android:hapticFeedbackEnabled="true"
                android:padding="0dp"
                android:text="Pause voting"
                android:textAllCaps="false"
                android:textColor="#0066FF"
                android:textSize="14sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_pause"
                app:iconTint="#0066FF"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:gravity="center"
                app:strokeColor="#0066FF"
                app:strokeWidth="1.5dp"
                app:backgroundTint="#FFFFFF"
                app:cornerRadius="12dp"
                android:insetBottom="0dp"
                android:insetTop="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEndVotingNow"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:hapticFeedbackEnabled="true"
                android:padding="0dp"
                android:text="End voting now"
                android:textAllCaps="false"
                android:textColor="#B91C1C"
                android:textSize="14sp"
                android:textStyle="bold"
                app:icon="@drawable/ic_stop"
                app:iconTint="#B91C1C"
                app:iconSize="18dp"
                app:iconGravity="textStart"
                app:iconPadding="8dp"
                android:gravity="center"
                app:strokeColor="#FECACA"
                app:strokeWidth="1.5dp"
                app:backgroundTint="#FEF2F2"
                app:cornerRadius="12dp"
                android:insetBottom="0dp"
                android:insetTop="0dp" />
        </LinearLayout>

        <!-- Manage CR Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnManageCR"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:hapticFeedbackEnabled="true"
            android:text="Manage CR (promote / demote)"
            android:textAllCaps="false"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="12dp"
            android:insetBottom="0dp"
            android:insetTop="0dp" />

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>

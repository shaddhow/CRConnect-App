<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:padding="20dp">

    <!-- BottomSheet Drag Handle Bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/glass_badge_bg"
        android:backgroundTint="#334155" />

    <!-- Top Purple Card (#8B85FE) -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#0066FF"
        app:cardCornerRadius="18dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Photo in, routine out"
                android:textColor="#FFFFFF"
                android:textSize="20sp"
                android:textStyle="bold"
                android:layout_marginBottom="6dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Point at your printed routine or pick a screenshot. Reads on your phone — nothing is uploaded."
                android:textColor="#F1F5F9"
                android:textSize="13sp"
                android:lineSpacingExtra="3dp"/>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Primary Button: Scan with camera -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScanCamera"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="10dp"
        android:text="Scan with camera"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#0066FF"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_camera"
        app:iconTint="#FFFFFF"
        app:iconGravity="textStart"
        app:iconPadding="8dp"/>

    <!-- Secondary Button: Choose from gallery -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnChooseGallery"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="20dp"
        android:text="Choose from gallery"
        android:textColor="#0066FF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:backgroundTint="#FFFFFF"
        app:strokeColor="#0066FF"
        app:strokeWidth="1.5dp"
        app:cornerRadius="12dp"
        app:icon="@drawable/ic_gallery"
        app:iconTint="#0066FF"
        app:iconGravity="textStart"
        app:iconPadding="8dp"/>

    <!-- Tips Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SCANNING TIPS"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="4dp"/>

    <!-- 4 Tips Grid -->
    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:layout_marginBottom="20dp">

        <!-- Tip 1: Good light -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/glass_card_bg"
            android:padding="10dp">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/glass_badge_bg"
                android:backgroundTint="#1E293B"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tip_light"
                    app:tint="#A5B4FC"
                    tools:ignore="ContentDescription"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Good light"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Tip 2: Fit whole routine -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/glass_card_bg"
            android:padding="10dp">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/glass_badge_bg"
                android:backgroundTint="#1E293B"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tip_fit"
                    app:tint="#A5B4FC"
                    tools:ignore="ContentDescription"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Fit whole routine"
                android:textColor="#E2E8F0"
                android:textSize="13sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Tip 3: Screenshots from PDFs -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/glass_card_bg"
            android:padding="10dp">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/glass_badge_bg"
                android:backgroundTint="#1E293B"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tip_pdf"
                    app:tint="#A5B4FC"
                    tools:ignore="ContentDescription"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Screenshots from PDFs"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Tip 4: Review before added -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_columnWeight="1"
            android:layout_margin="4dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/glass_card_bg"
            android:padding="10dp">

            <FrameLayout
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:background="@drawable/glass_badge_bg"
                android:backgroundTint="#1E293B"
                android:layout_marginEnd="8dp">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_tip_eye"
                    app:tint="#A5B4FC"
                    tools:ignore="ContentDescription"/>
            </FrameLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Review before added"
                android:textColor="#E2E8F0"
                android:textSize="12sp"
                android:textStyle="bold"/>
        </LinearLayout>
    </GridLayout>

    <!-- Footer Link: Or add classes manually -->
    <TextView
        android:id="@+id/btnAddManual"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Or add classes manually"
        android:textColor="#0066FF"
        android:textSize="14sp"
        android:textStyle="bold"
        android:gravity="center"
        android:padding="12dp"
        android:clickable="true"
        android:focusable="true"
        android:background="?attr/selectableItemBackground"/>

</LinearLayout>
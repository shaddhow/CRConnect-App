<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollViewLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_gradient_portal"
    tools:context=".LoginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootConstraint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <!-- 1. Logo / Brand Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutBranding"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Rounded rectangle logo card (72dp radius, 6dp white ring border, elevation 12dp) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLogo"
                android:layout_width="72dp"
                android:layout_height="72dp"
                android:padding="4dp"
                app:cardCornerRadius="24dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="6dp"
                app:strokeColor="#FFFFFF"
                app:cardElevation="12dp"
                app:cardPreventCornerOverlap="false"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_crconnect_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/app_name" />
            </com.google.android.material.card.MaterialCardView>

            <!-- App Title "CRConnect" -->
            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/title_text"
                android:letterSpacing="-0.02"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/cardLogo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Subtitle "BUBT Department Network" with BUBT Crest in Glass Pill Chip -->
            <LinearLayout
                android:id="@+id/layoutAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/glass_badge_pill"
                android:paddingHorizontal="14dp"
                android:paddingVertical="6dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:layout_width="24dp"
                    android:layout_height="28dp"
                    android:src="@drawable/bubt_logo"
                    android:scaleType="fitCenter"
                    android:layout_marginEnd="8dp"
                    android:contentDescription="@string/bubt_logo_desc" />

                <TextView
                    android:id="@+id/tvAppSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/title_text" />
            </LinearLayout>

            <!-- Pill Badge "Sign in to your class hub" -->
            <TextView
                android:id="@+id/tvWelcomeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_badge"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/primary"
                android:background="@drawable/glass_badge_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginTop="8dp"
                app:layout_constraintTop_toBottomOf="@id/layoutAppSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 3. White Card (Main Login Panel) with 16dp Spacer from Header -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLoginForm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:cardCornerRadius="32dp"
            app:cardBackgroundColor="@color/card_bg"
            app:strokeWidth="1dp"
            app:strokeColor="@color/slate_border_light"
            app:cardElevation="2dp"
            app:cardPreventCornerOverlap="false"
            app:layout_constraintTop_toBottomOf="@id/layoutBranding"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <!-- 3a. Segmented Control (Role Tabs) with Animated Sliding Indicator -->
                <FrameLayout
                    android:id="@+id/layoutSegmentedControl"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:background="@drawable/bg_segmented_container"
                    android:padding="4dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- Sliding Pill Indicator -->
                    <View
                        android:id="@+id/viewSegmentedIndicator"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_segmented_tab_active" />

                    <!-- Overlay Tabs -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tabStudent"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="@string/student"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#FFFFFF"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@android:color/transparent" />

                        <TextView
                            android:id="@+id/tabTeacher"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:text="@string/teacher"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="@color/slate_muted"
                            android:gravity="center"
                            android:clickable="true"
                            android:focusable="true"
                            android:background="@android:color/transparent" />
                    </LinearLayout>
                </FrameLayout>

                <!-- Form Content Layout (Horizontal Slide & Crossfade Target) -->
                <LinearLayout
                    android:id="@+id/layoutFormContent"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    app:layout_constraintTop_toBottomOf="@id/layoutSegmentedControl"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <!-- 3b. ID / Email Field Label -->
                    <TextView
                        android:id="@+id/tvIdLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/student_id_or_email"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/slate_dark"
                        android:layout_marginTop="20dp" />

                    <!-- Input Container for ID / Email Field -->
                    <LinearLayout
                        android:id="@+id/containerIdInput"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_input_normal"
                        android:layout_marginTop="4dp">

                        <ImageView
                            android:id="@+id/ivIdIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_user"
                            app:tint="@color/slate_icon"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="@string/cd_user_icon" />

                        <EditText
                            android:id="@+id/etIdInput"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/id_hint_student"
                            android:textColorHint="@color/slate_icon"
                            android:textColor="@color/slate_dark"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="textEmailAddress"
                            android:imeOptions="actionNext"
                            android:importantForAutofill="auto"
                            android:autofillHints="username,emailAddress"
                            android:singleLine="true" />
                    </LinearLayout>

                    <!-- ID Validation Error Message -->
                    <TextView
                        android:id="@+id/tvIdError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/error_id_empty"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/error_red"
                        android:visibility="gone"
                        android:layout_marginTop="4dp" />

                    <!-- 3c. Password Field Label -->
                    <TextView
                        android:id="@+id/tvPasswordLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/password"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/slate_dark"
                        android:layout_marginTop="16dp" />

                    <!-- Input Container for Password Field -->
                    <LinearLayout
                        android:id="@+id/containerPasswordInput"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:paddingHorizontal="16dp"
                        android:background="@drawable/bg_input_normal"
                        android:layout_marginTop="4dp">

                        <ImageView
                            android:id="@+id/ivPasswordIcon"
                            android:layout_width="20dp"
                            android:layout_height="20dp"
                            android:src="@drawable/ic_lock"
                            app:tint="@color/slate_icon"
                            android:layout_marginEnd="12dp"
                            android:contentDescription="@string/cd_lock_icon" />

                        <EditText
                            android:id="@+id/etPasswordInput"
                            android:layout_width="0dp"
                            android:layout_height="match_parent"
                            android:layout_weight="1"
                            android:background="@null"
                            android:hint="@string/password_placeholder"
                            android:textColorHint="@color/slate_icon"
                            android:textColor="@color/slate_dark"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium"
                            android:inputType="textPassword"
                            android:imeOptions="actionDone"
                            android:importantForAutofill="auto"
                            android:autofillHints="password"
                            android:singleLine="true" />

                        <ImageButton
                            android:id="@+id/btnTogglePassword"
                            android:layout_width="32dp"
                            android:layout_height="32dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:src="@drawable/ic_eye_toggle"
                            app:tint="@color/slate_muted"
                            android:contentDescription="@string/cd_toggle_password" />
                    </LinearLayout>

                    <!-- Password Validation Error Message -->
                    <TextView
                        android:id="@+id/tvPasswordError"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/error_password_empty"
                        android:textSize="12sp"
                        android:fontFamily="sans-serif"
                        android:textColor="@color/error_red"
                        android:visibility="gone"
                        android:layout_marginTop="4dp" />

                    <!-- 3d. Remember Me CheckBox (Placed directly below password field) -->
                    <com.google.android.material.checkbox.MaterialCheckBox
                        android:id="@+id/cbRememberMe"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="8dp"
                        android:text="@string/remember_me"
                        android:textSize="13sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/slate_dark"
                        app:buttonTint="@color/brand_blue"
                        android:checked="true"
                        android:minHeight="40dp" />

                    <!-- 3e. "Forgot password?" Link (Centered below Remember Me) -->
                    <TextView
                        android:id="@+id/tvForgotPassword"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:minHeight="44dp"
                        android:gravity="center"
                        android:text="@string/forgot_password"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/primary"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@android:color/transparent"
                        android:layout_marginTop="4dp" />

                    <!-- 3f. "Sign in" Primary Button with Loading Progress Spinner -->
                    <FrameLayout
                        android:id="@+id/layoutSignInContainer"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:layout_marginTop="16dp">

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnSignIn"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:text="@string/sign_in"
                            android:textSize="16sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            android:textColor="#FFFFFF"
                            android:textAllCaps="false"
                            app:cornerRadius="26dp"
                            android:background="@drawable/bg_btn_primary"
                            app:backgroundTint="@null"
                            app:elevation="0dp" />

                        <ProgressBar
                            android:id="@+id/pbSignInLoading"
                            style="?android:attr/progressBarStyleSmall"
                            android:layout_width="24dp"
                            android:layout_height="24dp"
                            android:layout_gravity="center"
                            android:indeterminateTint="#FFFFFF"
                            android:visibility="gone" />
                    </FrameLayout>
                </LinearLayout>

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 5. "Create an account" Secondary Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateAccount"
            android:layout_width="0dp"
            android:layout_height="50dp"
            android:text="@string/create_account"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/brand_blue"
            android:textAllCaps="false"
            app:cornerRadius="26dp"
            android:background="@drawable/bg_btn_secondary"
            app:backgroundTint="@null"
            app:elevation="0dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/cardLoginForm"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Developer Bypass Options (For Testing/Development) -->
        <LinearLayout
            android:id="@+id/layoutDevButtons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/btnCreateAccount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDevStudent"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/dev_student"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/brand_blue"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDevTeacher"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="48dp"
                android:paddingHorizontal="16dp"
                android:paddingVertical="8dp"
                android:text="@string/dev_teacher"
                android:textSize="12sp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/brand_blue"/>
        </LinearLayout>

        <!-- 6. Flexible Spacer (min 24dp) -->
        <View
            android:id="@+id/spacerFlex"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            app:layout_constraintTop_toBottomOf="@id/layoutDevButtons"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 7. Footer Text -->
        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bubt_full_name"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:textColor="@color/slate_dark_60"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/spacerFlex"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>

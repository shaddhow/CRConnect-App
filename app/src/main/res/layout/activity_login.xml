<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollViewLogin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:clipToPadding="false"
    tools:context=".LoginActivity">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/rootConstraint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="32dp"
        android:paddingBottom="24dp">

        <!-- 1. Logo / Brand Header -->
        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/layoutBranding"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Rounded rectangle logo card (96x112dp, 28dp radius, 6dp 45% white ring border, elevation) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLogo"
                android:layout_width="96dp"
                android:layout_height="112dp"
                app:cardCornerRadius="28dp"
                app:cardBackgroundColor="#FFFFFF"
                app:strokeWidth="6dp"
                app:strokeColor="#73FFFFFF"
                app:cardElevation="12dp"
                app:cardPreventCornerOverlap="false"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/ivLogo"
                    android:layout_width="64dp"
                    android:layout_height="80dp"
                    android:layout_gravity="center"
                    android:src="@drawable/bubt_logo"
                    android:scaleType="fitCenter"
                    android:contentDescription="@string/bubt_logo_desc" />
            </com.google.android.material.card.MaterialCardView>

            <!-- App Title "CRConnect" -->
            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textSize="28sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/slate_dark"
                android:letterSpacing="-0.02"
                android:layout_marginTop="12dp"
                app:layout_constraintTop_toBottomOf="@id/cardLogo"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Subtitle "BUBT Department Network" -->
            <TextView
                android:id="@+id/tvAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_subtitle"
                android:textSize="14sp"
                android:fontFamily="sans-serif"
                android:textColor="@color/slate_dark_72"
                android:layout_marginTop="2dp"
                app:layout_constraintTop_toBottomOf="@id/tvAppTitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Pill Badge "Sign in to your class hub" -->
            <TextView
                android:id="@+id/tvWelcomeBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/welcome_badge"
                android:textSize="13sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/brand_blue_dark"
                android:background="@drawable/glass_badge_pill"
                android:paddingHorizontal="12dp"
                android:paddingVertical="4dp"
                android:layout_marginTop="10dp"
                app:layout_constraintTop_toBottomOf="@id/tvAppSubtitle"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <!-- 3. White Card (Main Login Panel) with 32dp Spacer from Header -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLoginForm"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="32dp"
            app:cardCornerRadius="24dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="@color/slate_border_light"
            app:cardElevation="2dp"
            app:cardPreventCornerOverlap="false"
            app:layout_constraintTop_toBottomOf="@id/layoutBranding"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="24dp">

                <!-- 3a. Segmented Control (Role Tabs) -->
                <LinearLayout
                    android:id="@+id/layoutSegmentedControl"
                    android:layout_width="0dp"
                    android:layout_height="48dp"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_segmented_container"
                    android:padding="4dp"
                    app:layout_constraintTop_toTopOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <TextView
                        android:id="@+id/tabStudent"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/student"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/brand_blue"
                        android:background="@drawable/bg_segmented_tab_active"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />

                    <TextView
                        android:id="@+id/tabTeacher"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="@string/teacher"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/slate_muted"
                        android:background="@drawable/bg_segmented_tab_inactive"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true" />
                </LinearLayout>

                <!-- 3b. ID / Email Field Label -->
                <TextView
                    android:id="@+id/tvIdLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/student_id_or_email"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/slate_dark"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/layoutSegmentedControl"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Input Container for ID / Email Field -->
                <LinearLayout
                    android:id="@+id/containerIdInput"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_input_normal"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/tvIdLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:id="@+id/ivIdIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_user"
                        app:tint="@color/slate_icon"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@string/cd_user_icon" />

                    <EditText
                        android:id="@+id/etIdInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/id_hint_student"
                        android:textColorHint="@color/slate_icon"
                        android:textColor="@color/slate_dark"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:inputType="textEmailAddress"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="no"
                        android:singleLine="true" />
                </LinearLayout>

                <!-- ID Validation Error Message -->
                <TextView
                    android:id="@+id/tvIdError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/error_id_empty"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/error_red"
                    android:visibility="gone"
                    android:layout_marginTop="4dp"
                    app:layout_constraintTop_toBottomOf="@id/containerIdInput"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- 3c. Password Field Label -->
                <TextView
                    android:id="@+id/tvPasswordLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/password"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/slate_dark"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/tvIdError"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- Input Container for Password Field -->
                <LinearLayout
                    android:id="@+id/containerPasswordInput"
                    android:layout_width="0dp"
                    android:layout_height="54dp"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="16dp"
                    android:background="@drawable/bg_input_normal"
                    android:layout_marginTop="8dp"
                    app:layout_constraintTop_toBottomOf="@id/tvPasswordLabel"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent">

                    <ImageView
                        android:id="@+id/ivPasswordIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_lock"
                        app:tint="@color/slate_icon"
                        android:layout_marginEnd="12dp"
                        android:contentDescription="@string/cd_lock_icon" />

                    <EditText
                        android:id="@+id/etPasswordInput"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@null"
                        android:hint="@string/password_placeholder"
                        android:textColorHint="@color/slate_icon"
                        android:textColor="@color/slate_dark"
                        android:textSize="16sp"
                        android:fontFamily="sans-serif-medium"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:singleLine="true" />

                    <ImageButton
                        android:id="@+id/btnTogglePassword"
                        android:layout_width="32dp"
                        android:layout_height="32dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:src="@drawable/ic_eye_toggle"
                        app:tint="@color/slate_muted"
                        android:contentDescription="@string/cd_toggle_password" />
                </LinearLayout>

                <!-- Password Validation Error Message -->
                <TextView
                    android:id="@+id/tvPasswordError"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/error_password_empty"
                    android:textSize="12sp"
                    android:fontFamily="sans-serif"
                    android:textColor="@color/error_red"
                    android:visibility="gone"
                    android:layout_marginTop="4dp"
                    app:layout_constraintTop_toBottomOf="@id/containerPasswordInput"
                    app:layout_constraintStart_toStartOf="parent" />

                <!-- 3d. "Forgot password?" Link -->
                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="44dp"
                    android:gravity="center"
                    android:text="@string/forgot_password"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="@color/brand_blue"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_marginTop="12dp"
                    app:layout_constraintTop_toBottomOf="@id/tvPasswordError"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

                <!-- 3e. "Sign in" Primary Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSignIn"
                    android:layout_width="0dp"
                    android:layout_height="52dp"
                    android:text="@string/sign_in"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#FFFFFF"
                    android:textAllCaps="false"
                    app:cornerRadius="12dp"
                    android:background="@drawable/bg_btn_primary"
                    app:backgroundTint="@null"
                    app:elevation="0dp"
                    android:layout_marginTop="20dp"
                    app:layout_constraintTop_toBottomOf="@id/tvForgotPassword"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent" />

            </androidx.constraintlayout.widget.ConstraintLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- 4. Divider Row ("New here?") -->
        <View
            android:id="@+id/dividerLeft"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/slate_border_light"
            app:layout_constraintTop_toTopOf="@id/tvNewHere"
            app:layout_constraintBottom_toBottomOf="@id/tvNewHere"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/tvNewHere" />

        <TextView
            android:id="@+id/tvNewHere"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/new_here"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:textColor="@color/slate_muted"
            android:paddingHorizontal="12dp"
            android:layout_marginTop="24dp"
            app:layout_constraintTop_toBottomOf="@id/cardLoginForm"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <View
            android:id="@+id/dividerRight"
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:background="@color/slate_border_light"
            app:layout_constraintTop_toTopOf="@id/tvNewHere"
            app:layout_constraintBottom_toBottomOf="@id/tvNewHere"
            app:layout_constraintStart_toEndOf="@id/tvNewHere"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 5. "Create an account" Secondary Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnCreateAccount"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:text="@string/create_account"
            android:textSize="16sp"
            android:textStyle="bold"
            android:fontFamily="sans-serif-medium"
            android:textColor="@color/brand_blue"
            android:textAllCaps="false"
            app:cornerRadius="12dp"
            android:background="@drawable/bg_btn_secondary"
            app:backgroundTint="@null"
            app:elevation="0dp"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/tvNewHere"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Developer Bypass Options (For Testing/Development) -->
        <LinearLayout
            android:id="@+id/layoutDevButtons"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/btnCreateAccount"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDevStudent"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/dev_student"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:textColor="@color/brand_blue"
                android:layout_marginEnd="8dp"/>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnDevTeacher"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:text="@string/dev_teacher"
                android:textSize="11sp"
                android:fontFamily="sans-serif"
                android:textColor="@color/brand_blue"/>
        </LinearLayout>

        <!-- 6. Flexible Spacer (min 24dp) -->
        <View
            android:id="@+id/spacerFlex"
            android:layout_width="match_parent"
            android:layout_height="24dp"
            app:layout_constraintTop_toBottomOf="@id/layoutDevButtons"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- 7. Footer Text -->
        <TextView
            android:id="@+id/tvFooter"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/bubt_full_name"
            android:textSize="12sp"
            android:fontFamily="sans-serif"
            android:textColor="@color/slate_dark_60"
            android:gravity="center"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="16dp"
            app:layout_constraintTop_toBottomOf="@id/spacerFlex"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
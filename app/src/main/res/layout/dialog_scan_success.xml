<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@color/surface"
    android:padding="20dp">

    <!-- BottomSheet Drag Handle Bar -->
    <View
        android:layout_width="36dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/glass_badge_bg"
        android:backgroundTint="#334155" />

    <!-- Top Success Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="16dp"
        app:cardBackgroundColor="#10B981"
        app:cardCornerRadius="18dp"
        app:cardElevation="4dp"
        app:strokeWidth="0dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:padding="20dp">

            <ImageView
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_check"
                android:layout_marginEnd="16dp"
                app:tint="#FFFFFF"
                tools:ignore="ContentDescription"/>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tvSuccessTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Routine Scanned &amp; Saved!"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="4dp"/>

                <TextView
                    android:id="@+id/tvSuccessSubtitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Classes successfully synced to your schedule."
                    android:textColor="#ECFDF5"
                    android:textSize="13sp"/>
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Extracted Classes Header -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="EXTRACTED CLASSES SUMMARY"
        android:textColor="#94A3B8"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"
        android:layout_marginBottom="10dp"
        android:layout_marginStart="4dp"/>

    <!-- Classes Container Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="20dp"
        app:cardBackgroundColor="#1E293B"
        app:cardCornerRadius="14dp"
        app:strokeColor="#334155"
        app:strokeWidth="1dp">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:maxHeight="180dp">

            <LinearLayout
                android:id="@+id/containerSuccessClasses"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"/>
        </ScrollView>
    </com.google.android.material.card.MaterialCardView>

    <!-- Primary Button: View My Schedule -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnViewSchedule"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginBottom="10dp"
        android:text="View My Schedule"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#7C3AED"
        app:cornerRadius="14dp"/>

    <!-- Secondary Button: Scan Another Routine -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnScanAnother"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="Scan Another Routine"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="#1E293B"
        app:strokeColor="#334155"
        app:strokeWidth="1.5dp"
        app:cornerRadius="14dp"/>

</LinearLayout>

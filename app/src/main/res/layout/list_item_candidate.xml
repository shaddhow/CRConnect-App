<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCandidateItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:hapticFeedbackEnabled="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp"
    android:outlineAmbientShadowColor="#14000000"
    android:outlineSpotShadowColor="#14000000"
    tools:ignore="UnusedAttribute">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCandidateCardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Left: Serial Number Badge (44dp x 44dp in admin mode) -->
        <TextView
            android:id="@+id/tvCandidateRank"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_icon_square_blue"
            android:gravity="center"
            android:text="01"
            android:textColor="#0066FF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <!-- Center: Candidate Name -->
        <TextView
            android:id="@+id/tvCandidateName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Candidate Name"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/tvCandidatePct"
            app:layout_constraintStart_toEndOf="@id/tvCandidateRank"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <!-- Admin Sub-line: "N votes · Dept. of CSE" -->
        <TextView
            android:id="@+id/tvCandidateSubline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="0 votes · Dept. of CSE"
            android:textColor="#64748B"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/tvCandidatePct"
            app:layout_constraintStart_toEndOf="@id/tvCandidateRank"
            app:layout_constraintTop_toBottomOf="@id/tvCandidateName"
            tools:ignore="HardcodedText" />

        <!-- Admin Right: Percentage "P%" -->
        <TextView
            android:id="@+id/tvCandidatePct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/tvCandidateSubline"
            tools:ignore="HardcodedText" />

        <!-- Student Mode: Vote Count Badge -->
        <TextView
            android:id="@+id/tvCandidateVotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:text="0 Votes"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/tvCandidateRank"
            app:layout_constraintTop_toBottomOf="@id/tvCandidateName"
            tools:ignore="HardcodedText" />

        <!-- Student Mode: Department Badge -->
        <TextView
            android:id="@+id/tvCandidateDept"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/bg_chip_muted"
            android:ellipsize="end"
            android:singleLine="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Department of CSE, BUBT"
            android:textColor="#64748B"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toStartOf="@id/btnVoteCandidate"
            app:layout_constraintStart_toEndOf="@id/tvCandidateVotes"
            app:layout_constraintTop_toBottomOf="@id/tvCandidateName"
            tools:ignore="HardcodedText" />

        <!-- Student Mode: Vote Action Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoteCandidate"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:hapticFeedbackEnabled="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="16dp"
            android:text="Vote"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="#0066FF"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toTopOf="@id/pbCandidateVotes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <!-- Delete Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteCandidate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:hapticFeedbackEnabled="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:text="Delete"
            android:textColor="#B91C1C"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="#FEF2F2"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toTopOf="@id/pbCandidateVotes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="#FECACA"
            app:strokeWidth="1dp"
            tools:ignore="HardcodedText" />

        <!-- Bottom: Graphical Vote Progress Bar -->
        <ProgressBar
            android:id="@+id/pbCandidateVotes"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginTop="12dp"
            android:backgroundTint="#E2E8F0"
            android:max="100"
            android:progress="0"
            android:progressTint="#0066FF"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCandidateSubline" />

        <!-- Admin Mode: +1 Test Vote Link Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnTestVoteCandidate"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:minHeight="32dp"
            android:layout_marginTop="8dp"
            android:paddingHorizontal="0dp"
            android:paddingVertical="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:hapticFeedbackEnabled="true"
            android:text="+1 test vote"
            android:textAllCaps="false"
            android:textColor="#0066FF"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/pbCandidateVotes"
            app:layout_constraintBottom_toBottomOf="parent"
            tools:ignore="HardcodedText" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

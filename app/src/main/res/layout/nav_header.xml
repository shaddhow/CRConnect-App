<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:background="@drawable/bg_nav_header"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="20dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgNavHeaderProfile"
        android:layout_width="64dp"
        android:layout_height="64dp"
        android:src="@drawable/ic_crconnect_logo"
        android:scaleType="centerCrop"
        android:background="#FFFFFF"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
        app:strokeWidth="1dp"
        app:strokeColor="#E2E8F0"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvNavHeaderName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Test Teacher (Dev)"
        android:textColor="#0F172A"
        android:textSize="18sp"
        android:textStyle="bold"
        android:singleLine="true" />

    <TextView
        android:id="@+id/tvNavHeaderRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Teacher / Admin · Department of CSE, BUBT"
        android:textColor="#64748B"
        android:textSize="13sp"
        android:layout_marginTop="2dp"
        android:singleLine="true" />

</LinearLayout>

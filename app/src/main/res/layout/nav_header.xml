<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="180dp"
    android:background="@color/surface"
    android:gravity="bottom"
    android:orientation="vertical"
    android:padding="20dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgNavHeaderProfile"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:src="@drawable/bubt_logo"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circular"
        app:strokeWidth="2dp"
        app:strokeColor="@color/primary"
        android:layout_marginBottom="12dp" />

    <TextView
        android:id="@+id/tvNavHeaderName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CRConnect User"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:singleLine="true" />

    <TextView
        android:id="@+id/tvNavHeaderRole"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BUBT Department Network"
        android:textColor="#9CA3AF"
        android:textSize="12sp"
        android:layout_marginTop="2dp"
        android:singleLine="true" />

</LinearLayout>

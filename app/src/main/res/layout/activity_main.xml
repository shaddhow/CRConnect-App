<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollViewMain"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@color/background"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="24dp">

        <!-- Branding Section -->
        <LinearLayout
            android:id="@+id/layoutBranding"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:layout_marginBottom="28dp">

            <ImageView
                android:id="@+id/ivBubtLogo"
                android:layout_width="90dp"
                android:layout_height="90dp"
                android:src="@drawable/bubt_logo"
                android:scaleType="fitCenter"
                android:contentDescription="BUBT Logo"
                android:layout_marginBottom="16dp"/>

            <TextView
                android:id="@+id/tvAppTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CRConnect"
                android:textSize="24sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="#FFFFFF"
                android:letterSpacing="0.05"/>

            <TextView
                android:id="@+id/tvAppSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="BUBT Department Network"
                android:textSize="13sp"
                android:textStyle="normal"
                android:fontFamily="sans-serif"
                android:textColor="#A0AEC0"
                android:letterSpacing="0.05"
                android:layout_marginTop="4dp"/>
        </LinearLayout>

        <!-- Login Card Container (Figma-Inspired Dark Mode Surface) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="12dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/card_stroke">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Pill-Shaped Segmented Tab Toggle for Role Selection -->
                <RadioGroup
                    android:id="@+id/radioGroupRole"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:orientation="horizontal"
                    android:background="@drawable/segmented_bg"
                    android:padding="4dp"
                    android:layout_marginBottom="24dp">

                    <RadioButton
                        android:id="@+id/rbStudent"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Student"
                        android:checked="true"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="0.04"
                        android:textColor="@color/segmented_tab_text"
                        android:background="@drawable/segmented_tab_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:elevation="2dp"/>

                    <RadioButton
                        android:id="@+id/rbTeacher"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:text="Teacher"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif"
                        android:letterSpacing="0.04"
                        android:textColor="@color/segmented_tab_text"
                        android:background="@drawable/segmented_tab_selector"
                        android:button="@null"
                        android:gravity="center"
                        android:elevation="2dp"/>
                </RadioGroup>

                <!-- Input Fields with Material OutlinedBox Styling -->
                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint="Student ID or BUBT Email"
                    android:fontFamily="sans-serif"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxBackgroundColor="@color/input_bg"
                    app:boxStrokeColor="@color/input_box_stroke"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="2dp"
                    android:textColorHint="#94A3B8"
                    app:hintTextColor="#A78BFA">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:fontFamily="sans-serif"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="24dp"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                    android:hint="Password"
                    android:fontFamily="sans-serif"
                    app:boxCornerRadiusTopStart="12dp"
                    app:boxCornerRadiusTopEnd="12dp"
                    app:boxCornerRadiusBottomStart="12dp"
                    app:boxCornerRadiusBottomEnd="12dp"
                    app:boxBackgroundColor="@color/input_bg"
                    app:boxStrokeColor="@color/input_box_stroke"
                    app:boxStrokeWidth="1.5dp"
                    app:boxStrokeWidthFocused="2dp"
                    android:textColorHint="#94A3B8"
                    app:hintTextColor="#A78BFA"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#94A3B8">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:textColor="#FFFFFF"
                        android:textSize="14sp"
                        android:textStyle="normal"
                        android:fontFamily="sans-serif"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Primary CTA: SIGN IN Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnLogin"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:hapticFeedbackEnabled="true"
                    android:text="SIGN IN"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.05"
                    android:textColor="#FFFFFF"
                    app:cornerRadius="16dp"
                    android:background="@drawable/btn_gradient_glow"
                    app:backgroundTint="@null"
                    app:elevation="8dp"
                    android:layout_marginBottom="20dp"/>

                <!-- Minimalist Footer Links -->
                <TextView
                    android:id="@+id/tvForgotPassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Forgot Password?"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#A78BFA"
                    android:gravity="center"
                    android:padding="6dp"/>

                <TextView
                    android:id="@+id/tvDontHaveAccount"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Don't have an account?"
                    android:textSize="13sp"
                    android:fontFamily="sans-serif"
                    android:textColor="#94A3B8"
                    android:gravity="center"
                    android:padding="6dp"/>

                <TextView
                    android:id="@+id/tvRegisterLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Register"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:fontFamily="sans-serif-medium"
                    android:textColor="#C084FC"
                    android:gravity="center"
                    android:padding="6dp"
                    android:layout_marginBottom="16dp"/>

                <!-- DEV Bypass Buttons (Discreet, Borderless Text Buttons at the Bottom) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginTop="8dp">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDevStudent"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:hapticFeedbackEnabled="true"
                        android:text="⚡ DEV: Student"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif"
                        android:textColor="#FBBF24"
                        android:letterSpacing="0.02"
                        app:backgroundTint="@null"
                        android:layout_marginEnd="8dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnDevTeacher"
                        style="@style/Widget.Material3.Button.TextButton"
                        android:layout_width="wrap_content"
                        android:layout_height="36dp"
                        android:hapticFeedbackEnabled="true"
                        android:text="⚡ DEV: Teacher"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif"
                        android:textColor="#FBBF24"
                        android:letterSpacing="0.02"
                        app:backgroundTint="@null"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

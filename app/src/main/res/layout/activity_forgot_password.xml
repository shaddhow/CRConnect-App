<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollViewForgot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:clipToPadding="false"
    android:background="@drawable/bg_gradient"
    tools:context=".ForgotPasswordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/fBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_back_arrow"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset_password"
                android:textSize="22sp"
                android:textStyle="bold"
                android:fontFamily="sans-serif-medium"
                android:textColor="#0F172A"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Badge Icon -->
        <FrameLayout
            android:id="@+id/badgeContainer"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/badge_bg"
            android:elevation="6dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/badge"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_key_badge"
                android:contentDescription="@string/reset_password" />
        </FrameLayout>

        <!-- Main Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="#FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#E2E8F0"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:id="@+id/paneContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Step 1: Send Code Pane (p1) -->
                <LinearLayout
                    android:id="@+id/p1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Forgot your password?"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#0F172A"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forgot_sub"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textColor="#64748B"
                        android:layout_marginBottom="20dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/fId"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:hint="Student ID, teacher code or email"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="#FFFFFF"
                        app:boxStrokeColor="@color/input_box_stroke"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="1.5dp"
                        app:startIconDrawable="@drawable/ic_user"
                        app:startIconTint="#94A3B8"
                        android:textColorHint="#64748B"
                        app:hintTextColor="#0066FF">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/fid"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:inputType="textEmailAddress"
                            android:imeOptions="actionDone"
                            android:textColor="#0F172A"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/send"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/send_code"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="12dp"
                        android:background="@drawable/btn_primary_bg"
                        app:backgroundTint="@null" />
                </LinearLayout>

                <!-- Step 2: Verification Code & New Password Pane (p2 - Initially Gone) -->
                <LinearLayout
                    android:id="@+id/p2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enter_code"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#0F172A"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:id="@+id/sentTo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/enter_code_sub"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textColor="#64748B"
                        android:layout_marginBottom="20dp" />

                    <!-- 6-digit OTP Inputs -->
                    <LinearLayout
                        android:id="@+id/otp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:layout_marginBottom="20dp">

                        <EditText
                            android:id="@+id/otp1"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/edit_text_bg"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="#0F172A"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            tools:ignore="LabelFor" />

                        <EditText
                            android:id="@+id/otp2"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/edit_text_bg"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="#0F172A"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            tools:ignore="LabelFor" />

                        <EditText
                            android:id="@+id/otp3"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/edit_text_bg"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="#0F172A"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            tools:ignore="LabelFor" />

                        <EditText
                            android:id="@+id/otp4"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/edit_text_bg"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="#0F172A"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            tools:ignore="LabelFor" />

                        <EditText
                            android:id="@+id/otp5"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:layout_marginEnd="4dp"
                            android:background="@drawable/edit_text_bg"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="#0F172A"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            tools:ignore="LabelFor" />

                        <EditText
                            android:id="@+id/otp6"
                            android:layout_width="0dp"
                            android:layout_height="56dp"
                            android:layout_weight="1"
                            android:background="@drawable/edit_text_bg"
                            android:gravity="center"
                            android:inputType="number"
                            android:maxLength="1"
                            android:textColor="#0F172A"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:fontFamily="sans-serif-medium"
                            tools:ignore="LabelFor" />
                    </LinearLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/fPw"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                        android:hint="@string/new_password"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="#FFFFFF"
                        app:boxStrokeColor="@color/input_box_stroke"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="1.5dp"
                        app:startIconDrawable="@drawable/ic_lock"
                        app:startIconTint="#94A3B8"
                        app:endIconMode="password_toggle"
                        app:endIconTint="#64748B"
                        android:textColorHint="#64748B"
                        app:hintTextColor="#0066FF">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/npw"
                            android:layout_width="match_parent"
                            android:layout_height="54dp"
                            android:inputType="textPassword"
                            android:imeOptions="actionDone"
                            android:textColor="#0F172A"
                            android:textSize="16sp"
                            android:fontFamily="sans-serif-medium" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/reset"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/reset_password"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="12dp"
                        android:background="@drawable/btn_primary_bg"
                        app:backgroundTint="@null"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:id="@+id/again"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/use_different_id"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#0066FF"
                        android:padding="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="?attr/selectableItemBackgroundBorderless" />
                </LinearLayout>

                <!-- Step 3: Success Pane (p3 - Initially Gone) -->
                <LinearLayout
                    android:id="@+id/p3"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:visibility="gone">

                    <FrameLayout
                        android:id="@+id/tick"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/tick_badge_bg"
                        android:elevation="6dp"
                        android:layout_marginBottom="20dp">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_check_tick"
                            android:contentDescription="@string/password_updated" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/password_updated"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#0F172A"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/password_updated_sub"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif"
                        android:textColor="#64748B"
                        android:gravity="center"
                        android:layout_marginBottom="24dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/done"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/back_to_sign_in"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="12dp"
                        android:background="@drawable/btn_primary_bg"
                        app:backgroundTint="@null" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

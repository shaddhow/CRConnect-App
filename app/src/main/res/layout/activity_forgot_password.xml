<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollViewForgot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:overScrollMode="ifContentScrolls"
    android:clipToPadding="false"
    android:background="@drawable/bg_gradient"
    tools:context=".ForgotPasswordActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="12dp"
        android:paddingBottom="24dp">

        <!-- Header Bar -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="16dp">

            <ImageButton
                android:id="@+id/fBack"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_back_arrow"
                app:tint="@color/title_text"
                android:background="@android:color/transparent"
                android:contentDescription="@string/app_name" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/reset_password"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="@color/title_text"
                android:layout_marginStart="8dp" />
        </LinearLayout>

        <!-- Glowing Badge Icon -->
        <FrameLayout
            android:id="@+id/badgeContainer"
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_gravity="center_horizontal"
            android:background="@drawable/badge_bg"
            android:elevation="4dp"
            android:layout_marginBottom="24dp">

            <ImageView
                android:id="@+id/badge"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_key_badge"
                app:tint="#FFFFFF"
                android:contentDescription="@string/reset_password" />
        </FrameLayout>

        <!-- Main Card Container -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="24dp"
            app:cardElevation="2dp"
            app:cardPreventCornerOverlap="false"
            app:cardBackgroundColor="@color/card_bg"
            app:strokeWidth="1dp"
            app:strokeColor="@color/slate_border_light"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:id="@+id/paneContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <!-- Step 1: Request Reset Link Pane (p1) -->
                <LinearLayout
                    android:id="@+id/p1"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forgot_your_password_title"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/title_text"
                        android:layout_marginBottom="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/forgot_sub"
                        android:textSize="14sp"
                        android:textColor="@color/muted_text"
                        android:layout_marginBottom="20dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/id_or_email_hint"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/title_text"
                        android:layout_marginBottom="8dp" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/fId"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="24dp"
                        android:textColorHint="@color/muted_text"
                        app:hintEnabled="false"
                        app:boxCornerRadiusTopStart="12dp"
                        app:boxCornerRadiusTopEnd="12dp"
                        app:boxCornerRadiusBottomStart="12dp"
                        app:boxCornerRadiusBottomEnd="12dp"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxStrokeColor="@color/input_box_stroke"
                        app:boxStrokeWidth="1dp"
                        app:boxStrokeWidthFocused="1.5dp"
                        app:startIconDrawable="@drawable/ic_user"
                        app:startIconTint="@color/muted_text">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/fid"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:gravity="center_vertical"
                            android:hint="@string/id_hint_forgot"
                            android:inputType="textEmailAddress"
                            android:imeOptions="actionDone"
                            android:textColor="@color/title_text"
                            android:textColorHint="@color/muted_text"
                            android:textSize="15sp" />
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/send"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/send_reset_link"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/primary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>

                <!-- Step 2: Email Sent Success Pane (p2 - Initially Gone) -->
                <LinearLayout
                    android:id="@+id/p2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:gravity="center_horizontal"
                    android:visibility="gone">

                    <FrameLayout
                        android:id="@+id/tick"
                        android:layout_width="72dp"
                        android:layout_height="72dp"
                        android:background="@drawable/tick_badge_bg"
                        android:elevation="6dp"
                        android:layout_marginBottom="20dp">

                        <ImageView
                            android:layout_width="34dp"
                            android:layout_height="34dp"
                            android:layout_gravity="center"
                            android:src="@drawable/ic_check_tick"
                            android:contentDescription="@string/check_email_title" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/check_email_title"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        android:textColor="@color/title_text"
                        android:layout_marginBottom="8dp" />

                    <TextView
                        android:id="@+id/sentTo"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/check_email_sub"
                        android:textSize="14sp"
                        android:textColor="@color/title_text"
                        android:gravity="center"
                        android:layout_marginBottom="12dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/check_email_help"
                        android:textSize="13sp"
                        android:textColor="@color/muted_text"
                        android:gravity="center"
                        android:layout_marginBottom="24dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/done"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/back_to_sign_in"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:textColor="#FFFFFF"
                        app:cornerRadius="12dp"
                        app:backgroundTint="@color/primary"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_marginBottom="12dp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResend"
                        style="@style/Widget.Material3.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/resend_reset_email"
                        android:textSize="15sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        app:strokeColor="@color/primary"
                        app:strokeWidth="1.5dp"
                        app:cornerRadius="12dp"
                        android:insetTop="0dp"
                        android:insetBottom="0dp"
                        android:layout_marginBottom="16dp" />

                    <TextView
                        android:id="@+id/again"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_horizontal"
                        android:text="@string/use_different_id"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="@color/primary"
                        android:padding="6dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:background="@android:color/transparent" />
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

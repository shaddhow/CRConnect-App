<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="center"
    android:paddingTop="36dp"
    android:paddingBottom="24dp">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgUserProfile"
        android:layout_width="84dp"
        android:layout_height="84dp"
        android:src="@drawable/ic_app_main"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circular"
        android:padding="2dp"
        app:strokeWidth="3dp"
        app:strokeColor="#6366F1"
        android:layout_marginBottom="14dp"/>

    <TextView
        android:id="@+id/tvHeaderTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Dashboard"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#F8FAFC"
        android:fontFamily="sans-serif-medium"/>

    <TextView
        android:id="@+id/tvHeaderSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BUBT Network"
        android:textSize="14sp"
        android:textColor="#94A3B8"
        android:alpha="0.95"
        android:layout_marginTop="4dp"/>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginTop="12dp"
        app:icon="@android:drawable/ic_lock_power_off"
        app:iconTint="#F8FAFC"
        app:iconSize="20dp"
        android:backgroundTint="#26334155"/>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="12dp"
    android:layout_marginBottom="16dp">

    <!-- Drawer Hamburger Menu Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenDrawer"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:hapticFeedbackEnabled="true"
        android:backgroundTint="@color/input_bg"
        app:icon="@android:drawable/ic_menu_sort_by_size"
        app:iconSize="22dp"
        app:iconTint="#FFFFFF"
        app:layout_constraintTop_toTopOf="@id/imgUserProfile"
        app:layout_constraintBottom_toBottomOf="@id/imgUserProfile"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- User Profile Avatar -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgUserProfile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_marginStart="12dp"
        app:layout_constraintStart_toEndOf="@id/btnOpenDrawer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bubt_logo"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circular"
        app:strokeColor="@color/primary"
        app:strokeWidth="2dp" />

    <!-- Title and Subtitle Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="@id/imgUserProfile"
        app:layout_constraintBottom_toBottomOf="@id/imgUserProfile"
        app:layout_constraintStart_toEndOf="@id/imgUserProfile"
        app:layout_constraintEnd_toStartOf="@id/tvSecureBadge">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:text="Dashboard"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeaderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="BUBT Network"
            android:textColor="#94A3B8"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Live Secure Status Badge -->
    <TextView
        android:id="@+id/tvSecureBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Secure"
        android:textSize="11sp"
        android:textColor="#94A3B8"
        android:textStyle="bold"
        android:background="@color/input_bg"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@id/imgUserProfile"
        app:layout_constraintBottom_toBottomOf="@id/imgUserProfile"
        app:layout_constraintEnd_toStartOf="@id/btnLogout" />

    <!-- Logout Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:hapticFeedbackEnabled="true"
        app:icon="@android:drawable/ic_lock_power_off"
        app:iconTint="#FFFFFF"
        app:iconSize="22dp"
        android:backgroundTint="@color/input_bg"
        app:layout_constraintTop_toTopOf="@id/imgUserProfile"
        app:layout_constraintBottom_toBottomOf="@id/imgUserProfile"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

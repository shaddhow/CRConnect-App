<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingVertical="12dp"
    android:paddingHorizontal="4dp"
    android:layout_marginBottom="16dp">

    <!-- Drawer Hamburger Menu Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenDrawer"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        app:icon="@android:drawable/ic_menu_sort_by_size"
        app:iconTint="#FFFFFF"
        app:iconSize="22dp"
        android:backgroundTint="@color/input_bg"
        android:layout_marginEnd="12dp" />

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgUserProfile"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@drawable/bubt_logo"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circular"
        app:strokeWidth="2dp"
        app:strokeColor="@color/primary"
        android:layout_marginEnd="12dp"/>

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Dashboard"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#FFFFFF"
            android:fontFamily="sans-serif-medium"/>

        <TextView
            android:id="@+id/tvHeaderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BUBT Network"
            android:textSize="12sp"
            android:textColor="#9CA3AF"
            android:layout_marginTop="2dp"
            android:singleLine="true"
            android:ellipsize="end"/>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Live Secure Status Badge -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Secure"
            android:textSize="11sp"
            android:textColor="#9CA3AF"
            android:textStyle="bold"
            android:background="@color/input_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:layout_marginEnd="8dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnLogout"
            style="@style/Widget.Material3.Button.IconButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            app:icon="@android:drawable/ic_lock_power_off"
            app:iconTint="#FFFFFF"
            app:iconSize="18dp"
            android:backgroundTint="@color/input_bg"/>
    </LinearLayout>

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:paddingVertical="8dp"
    android:layout_marginBottom="16dp">

    <!-- Drawer Hamburger Menu Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenDrawer"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:hapticFeedbackEnabled="true"
        android:backgroundTint="#FFFFFF"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp"
        app:cornerRadius="22dp"
        app:icon="@drawable/ic_menu"
        app:iconSize="20dp"
        app:iconTint="#0F172A"
        app:layout_constraintTop_toTopOf="@id/imgUserProfile"
        app:layout_constraintBottom_toBottomOf="@id/imgUserProfile"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- User Profile Avatar -->
    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/imgUserProfile"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:layout_marginStart="10dp"
        app:layout_constraintStart_toEndOf="@id/btnOpenDrawer"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:scaleType="centerCrop"
        android:src="@drawable/bubt_logo"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circular"
        app:strokeColor="#FFFFFF"
        app:strokeWidth="3dp" />

    <!-- Title and Subtitle Container -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="8dp"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="@id/imgUserProfile"
        app:layout_constraintBottom_toBottomOf="@id/imgUserProfile"
        app:layout_constraintStart_toEndOf="@id/imgUserProfile"
        app:layout_constraintEnd_toStartOf="@id/tvSecureBadge">

        <TextView
            android:id="@+id/tvHeaderTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Admin Console · Sec 6"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvHeaderSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="1dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Test Teacher (Dev) · CSE"
            android:textColor="#334155"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Live Secure Status Badge -->
    <TextView
        android:id="@+id/tvSecureBadge"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Secure"
        android:textSize="12sp"
        android:textColor="#166534"
        android:textStyle="bold"
        android:background="@drawable/bg_chip_ok"
        android:paddingHorizontal="10dp"
        android:paddingVertical="4dp"
        android:layout_marginEnd="8dp"
        app:layout_constraintTop_toTopOf="@id/imgUserProfile"
        app:layout_constraintBottom_toBottomOf="@id/imgUserProfile"
        app:layout_constraintEnd_toStartOf="@id/btnLogout" />

    <!-- Logout Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogout"
        style="@style/Widget.Material3.Button.IconButton"
        android:layout_width="44dp"
        android:layout_height="44dp"
        android:hapticFeedbackEnabled="true"
        app:icon="@drawable/ic_power"
        app:iconTint="#0F172A"
        app:iconSize="20dp"
        android:backgroundTint="#FFFFFF"
        app:strokeColor="#E2E8F0"
        app:strokeWidth="1dp"
        app:cornerRadius="22dp"
        app:layout_constraintTop_toTopOf="@id/imgUserProfile"
        app:layout_constraintBottom_toBottomOf="@id/imgUserProfile"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

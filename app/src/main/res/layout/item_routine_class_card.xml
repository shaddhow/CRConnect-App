<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="16dp">

        <!-- Left Time Slot Badge Box (.tm) -->
        <LinearLayout
            android:layout_width="72dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_chip_muted"
            android:backgroundTint="#E6F0FF"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="4dp"
            android:paddingVertical="10dp">

            <TextView
                android:id="@+id/tvTimeSlot"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:textColor="#0066FF"
                android:textSize="12sp"
                android:textStyle="bold"
                tools:text="08:15 AM\n09:45 AM" />

        </LinearLayout>

        <!-- Right Content Details (.nm) -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Course Title -->
            <TextView
                android:id="@+id/tvCourseName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#0F172A"
                android:textSize="16sp"
                android:textStyle="bold"
                tools:text="CSE 210" />

            <!-- Faculty Code -->
            <TextView
                android:id="@+id/tvFacultyCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#64748B"
                android:textSize="13sp"
                tools:text="FC: MDSS" />

            <!-- Pill Row (.pill-row) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Room Pill -->
                <TextView
                    android:id="@+id/tvRoomPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_chip_muted"
                    android:backgroundTint="#E6F0FF"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:textColor="#0066FF"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    tools:text="2517" />

                <!-- Duration Pill -->
                <TextView
                    android:id="@+id/tvDurationPill"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:background="@drawable/bg_chip_muted"
                    android:backgroundTint="#E6F0FF"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="4dp"
                    android:text="1h 30m"
                    android:textColor="#0066FF"
                    android:textSize="11sp"
                    android:textStyle="bold" />

            </LinearLayout>

            <!-- Attended / Missed Action Row (.att-row) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <!-- Attended Button -->
                <TextView
                    android:id="@+id/btnAttended"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:background="@drawable/bg_chip_green"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="✓ Attended"
                    android:textColor="#16A34A"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <!-- Missed Button -->
                <TextView
                    android:id="@+id/btnMissed"
                    android:layout_width="wrap_content"
                    android:layout_height="32dp"
                    android:layout_marginStart="8dp"
                    android:background="@drawable/bg_chip_warn"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center"
                    android:paddingHorizontal="12dp"
                    android:text="✕ Missed"
                    android:textColor="#DC2626"
                    android:textSize="12sp"
                    android:textStyle="bold" />

            </LinearLayout>

        </LinearLayout>

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>
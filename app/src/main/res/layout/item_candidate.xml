<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCandidateItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:hapticFeedbackEnabled="true"
    app:cardBackgroundColor="@color/glass_card"
    app:cardCornerRadius="18dp"
    app:cardElevation="6dp"
    app:strokeColor="#30FFFFFF"
    app:strokeWidth="1dp">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp">

        <!-- Left: Glassy Serial Number Badge -->
        <TextView
            android:id="@+id/tvCandidateRank"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/glass_badge_bg"
            android:gravity="center"
            android:text="01"
            android:textColor="#38BDF8"
            android:textSize="14sp"
            android:textStyle="bold"
            app:layout_constraintBottom_toTopOf="@id/pbCandidateVotes"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <!-- Center: Candidate Name -->
        <TextView
            android:id="@+id/tvCandidateName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Candidate Name"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnVoteCandidate"
            app:layout_constraintStart_toEndOf="@id/tvCandidateRank"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <!-- Center: Vote Count Badge -->
        <TextView
            android:id="@+id/tvCandidateVotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/glass_badge_bg"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="0 Votes"
            android:textColor="#A78BFA"
            android:textSize="12sp"
            android:textStyle="bold"
            app:layout_constraintStart_toEndOf="@id/tvCandidateRank"
            app:layout_constraintTop_toBottomOf="@id/tvCandidateName"
            tools:ignore="HardcodedText" />

        <!-- Center: Department Badge -->
        <TextView
            android:id="@+id/tvCandidateDept"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/glass_badge_bg"
            android:ellipsize="end"
            android:singleLine="true"
            android:paddingHorizontal="10dp"
            android:paddingVertical="4dp"
            android:text="Department of CSE, BUBT"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnVoteCandidate"
            app:layout_constraintStart_toEndOf="@id/tvCandidateVotes"
            app:layout_constraintTop_toBottomOf="@id/tvCandidateName"
            tools:ignore="HardcodedText" />

        <!-- Right: Action / Status Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoteCandidate"
            style="@style/Widget.Material3.Button.ElevatedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:hapticFeedbackEnabled="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="16dp"
            android:text="Vote"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:textStyle="bold"
            app:backgroundTint="#6366F1"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toTopOf="@id/pbCandidateVotes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <!-- Hidden / Optional Delete Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteCandidate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:hapticFeedbackEnabled="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="12dp"
            android:text="Delete"
            android:textColor="#EF4444"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:backgroundTint="@android:color/transparent"
            app:cornerRadius="12dp"
            app:layout_constraintBottom_toTopOf="@id/pbCandidateVotes"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:strokeColor="#EF4444"
            app:strokeWidth="1dp"
            tools:ignore="HardcodedText" />

        <!-- Bottom: Graphical Vote Progress Bar -->
        <ProgressBar
            android:id="@+id/pbCandidateVotes"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="8dp"
            android:layout_marginTop="14dp"
            android:backgroundTint="#222938"
            android:max="50"
            android:progress="0"
            android:progressTint="#A78BFA"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCandidateVotes" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

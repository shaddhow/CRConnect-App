<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/cardCandidateItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:hapticFeedbackEnabled="true"
    app:cardBackgroundColor="#FFFFFF"
    app:cardCornerRadius="20dp"
    app:cardElevation="2dp"
    app:strokeColor="#E2E8F0"
    app:strokeWidth="1dp"
    tools:ignore="UnusedAttribute">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutCandidateCardContent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <!-- Left: Serial Number Badge (44dp x 44dp, #E6F0FF background, #0066FF text) -->
        <TextView
            android:id="@+id/tvCandidateRank"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/badge_bg"
            android:gravity="center"
            android:text="01"
            android:textColor="#0066FF"
            android:textSize="15sp"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <!-- Center: Candidate Name -->
        <TextView
            android:id="@+id/tvCandidateName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="Candidate Name"
            android:textColor="#0F172A"
            android:textSize="16sp"
            android:textStyle="bold"
            app:layout_constraintEnd_toStartOf="@id/btnVoteCandidate"
            app:layout_constraintStart_toEndOf="@id/tvCandidateRank"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <!-- Center Subline: "1 votes · Dept. of CSE" -->
        <TextView
            android:id="@+id/tvCandidateSubline"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_marginTop="2dp"
            android:layout_marginEnd="12dp"
            android:ellipsize="end"
            android:singleLine="true"
            android:text="0 votes · Dept. of CSE"
            android:textColor="#64748B"
            android:textSize="12sp"
            app:layout_constraintEnd_toStartOf="@id/btnVoteCandidate"
            app:layout_constraintStart_toEndOf="@id/tvCandidateRank"
            app:layout_constraintTop_toBottomOf="@id/tvCandidateName"
            tools:ignore="HardcodedText" />

        <!-- Percentage (Hidden in student mode) -->
        <TextView
            android:id="@+id/tvCandidatePct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0%"
            android:textColor="#0F172A"
            android:textSize="18sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <!-- Votes Badge (Hidden or used) -->
        <TextView
            android:id="@+id/tvCandidateVotes"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="0 Votes"
            android:textColor="#64748B"
            android:textSize="12sp"
            android:textStyle="bold"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/tvCandidateRank"
            app:layout_constraintTop_toBottomOf="@id/tvCandidateName"
            tools:ignore="HardcodedText" />

        <!-- Department Badge (Hidden) -->
        <TextView
            android:id="@+id/tvCandidateDept"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:visibility="gone"
            app:layout_constraintStart_toEndOf="@id/tvCandidateVotes"
            app:layout_constraintTop_toBottomOf="@id/tvCandidateName"
            tools:ignore="HardcodedText" />

        <!-- Right: Vote Action Button (40dp height, min-width 84dp, 12dp radius) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnVoteCandidate"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:minWidth="84dp"
            android:hapticFeedbackEnabled="true"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:paddingHorizontal="14dp"
            android:text="Vote"
            android:textColor="#FFFFFF"
            android:textSize="14sp"
            android:textStyle="bold"
            app:backgroundTint="#0066FF"
            app:cornerRadius="12dp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toBottomOf="@id/tvCandidateSubline"
            tools:ignore="HardcodedText" />

        <!-- Delete Button (Hidden) -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnDeleteCandidate"
            style="@style/Widget.Material3.Button.OutlinedButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:visibility="gone"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            tools:ignore="HardcodedText" />

        <!-- Bottom: Vote Progress Bar (Height 6dp, #0066FF tint, #E2E8F0 background) -->
        <ProgressBar
            android:id="@+id/pbCandidateVotes"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="0dp"
            android:layout_height="6dp"
            android:layout_marginTop="16dp"
            android:backgroundTint="#E2E8F0"
            android:max="100"
            android:progress="0"
            android:progressTint="#0066FF"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tvCandidateSubline" />

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>

<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_card_bg"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvPdfTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Official Election PDF Ready"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#FFFFFF" />

    <TextView
        android:id="@+id/tvPdfMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Report successfully compiled! Select how you would like to output, share, or open the document:"
        android:textSize="14sp"
        android:textColor="#94A3B8"
        android:paddingTop="12dp"
        android:paddingBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrintPdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:layout_marginTop="8dp"
        android:hapticFeedbackEnabled="true"
        android:text="Print / Save PDF"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:backgroundTint="@color/primary"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSharePdf"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:layout_marginTop="16dp"
        android:hapticFeedbackEnabled="true"
        android:text="Share PDF"
        android:textColor="#94A3B8"
        android:textSize="14sp"
        app:strokeColor="@color/card_stroke"
        app:strokeWidth="1.5dp"
        app:backgroundTint="@android:color/transparent"
        app:cornerRadius="12dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenPdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="50dp"
        android:layout_marginTop="16dp"
        android:hapticFeedbackEnabled="true"
        android:text="Open PDF"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:backgroundTint="@color/primary"
        app:cornerRadius="12dp" />

</LinearLayout>

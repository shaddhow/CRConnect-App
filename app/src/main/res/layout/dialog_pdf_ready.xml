<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="#171A29"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvPdfTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="📄 Official Election PDF Ready"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="#38BDF8" />

    <TextView
        android:id="@+id/tvPdfMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Report successfully compiled! Select how you would like to output, share, or open the document:"
        android:textSize="14sp"
        android:textColor="#CBD5E1"
        android:paddingTop="12dp"
        android:paddingBottom="24dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrintPdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_marginTop="8dp"
        android:text="🖨️ Print / Save PDF"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:backgroundTint="#0284C7"
        app:cornerRadius="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSharePdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_marginTop="16dp"
        android:text="📤 Share PDF"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:backgroundTint="#6366F1"
        app:cornerRadius="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenPdf"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:layout_marginTop="16dp"
        android:text="📂 Open PDF"
        android:textColor="#FFFFFF"
        android:textSize="14sp"
        app:backgroundTint="#10B981"
        app:cornerRadius="16dp" />

</LinearLayout>

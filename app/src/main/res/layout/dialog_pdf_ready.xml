<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/pdfBottomSheetRoot"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_sheet"
    android:paddingHorizontal="20dp"
    android:paddingTop="12dp"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_grab_handle" />

    <TextView
        android:id="@+id/tvPdfTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Official election PDF ready"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textFontWeight="800"
        tools:targetApi="p"
        android:textColor="#0F172A" />

    <TextView
        android:id="@+id/tvPdfMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Report compiled. Choose how to save, share or open it."
        android:textSize="16sp"
        android:textColor="#64748B"
        android:paddingTop="6dp"
        android:paddingBottom="20dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnPrintPdf"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:hapticFeedbackEnabled="true"
        android:text="Print / Save PDF"
        android:textColor="#FFFFFF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:backgroundTint="@color/primary"
        app:cornerRadius="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnSharePdf"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:hapticFeedbackEnabled="true"
        android:text="Share PDF"
        android:textColor="#0066FF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:strokeColor="#0066FF"
        app:strokeWidth="1dp"
        app:backgroundTint="#FFFFFF"
        app:cornerRadius="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnOpenPdf"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_marginTop="12dp"
        android:hapticFeedbackEnabled="true"
        android:text="Open PDF"
        android:textColor="#0066FF"
        android:textSize="15sp"
        android:textStyle="bold"
        app:strokeColor="#0066FF"
        app:strokeWidth="1dp"
        app:backgroundTint="#FFFFFF"
        app:cornerRadius="12dp"
        android:insetTop="0dp"
        android:insetBottom="0dp" />

</LinearLayout>

<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background"
    tools:context=".RoutineActivity">

    <!-- Header Toolbar -->
    <LinearLayout
        android:id="@+id/layoutRoutineHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="16dp"
        android:paddingBottom="12dp"
        app:layout_constraintTop_toTopOf="parent">

        <!-- Circular Menu / Back Icon Left -->
        <FrameLayout
            android:id="@+id/btnRoutineBack"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/glass_badge_bg"
            android:clickable="true"
            android:focusable="true">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:src="@drawable/ic_nav_home"
                app:tint="#FFFFFF"
                tools:ignore="ContentDescription" />
        </FrameLayout>

        <!-- Dynamic Greeting Title & Subtitle Date -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingHorizontal="14dp">

            <TextView
                android:id="@+id/tvGreetingTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Burning the midnight oil"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:ellipsize="end"
                android:maxLines="1"/>

            <TextView
                android:id="@+id/tvHeaderDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="Wednesday, 14 October"
                android:textColor="#94A3B8"
                android:textSize="13sp"
                android:layout_marginTop="2dp"/>
        </LinearLayout>

        <!-- Circular + FAB Right to Open Scan BottomSheet (Re-scan / Upload) -->
        <FrameLayout
            android:id="@+id/btnScanRoutine"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/glass_badge_bg"
            android:backgroundTint="#0066FF"
            android:clickable="true"
            android:focusable="true">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="+"
                android:textColor="#FFFFFF"
                android:textSize="24sp"
                android:textStyle="bold"/>
        </FrameLayout>

    </LinearLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/scrollViewRoutine"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/layoutRoutineHeader"
        app:layout_constraintBottom_toTopOf="@id/bottomNavRoutine">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="20dp"
            android:paddingBottom="24dp">

            <!-- Hero Card ('UP NEXT' Class - Design 3 Style) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardUpNext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="20dp"
                android:visibility="gone"
                app:cardBackgroundColor="#121622"
                app:cardCornerRadius="20dp"
                app:cardElevation="8dp"
                app:strokeColor="#0066FF"
                app:strokeWidth="1.5dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Top Row: 'UP NEXT' Pill + Countdown -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="16dp">

                        <!-- 'UP NEXT' Status Pill -->
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="center_vertical"
                            android:background="@drawable/glass_card_bg"
                            android:paddingHorizontal="12dp"
                            android:paddingVertical="6dp">

                            <View
                                android:layout_width="6dp"
                                android:layout_height="6dp"
                                android:background="@drawable/glass_badge_bg"
                                android:backgroundTint="#0066FF"
                                android:layout_marginEnd="6dp"/>

                            <TextView
                                android:id="@+id/tvUpNextStatusPill"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="UP NEXT"
                                android:textColor="#FFFFFF"
                                android:textSize="11sp"
                                android:textStyle="bold"/>
                        </LinearLayout>

                        <View
                            android:layout_width="0dp"
                            android:layout_height="0dp"
                            android:layout_weight="1"/>

                        <TextView
                            android:id="@+id/tvUpNextCountdown"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            tools:text="Starts in 10h 51m"
                            android:textColor="#E2E8F0"
                            android:textSize="12sp"
                            android:textStyle="bold"
                            android:background="@drawable/glass_card_bg"
                            android:paddingHorizontal="14dp"
                            android:paddingVertical="6dp"/>
                    </LinearLayout>

                    <!-- Main Content Row: Course Code + Time Range (Left) & Room Badge (Right) -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <!-- Bold Course Code -->
                            <TextView
                                android:id="@+id/tvUpNextSubject"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="CSE 208"
                                android:textColor="#FFFFFF"
                                android:textSize="24sp"
                                android:textStyle="bold"
                                android:layout_marginBottom="2dp"/>

                            <!-- Faculty -->
                            <TextView
                                android:id="@+id/tvUpNextFaculty"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="FC: AAG"
                                android:textColor="#94A3B8"
                                android:textSize="13sp"
                                android:layout_marginBottom="6dp"/>

                            <!-- Time Range -->
                            <TextView
                                android:id="@+id/tvUpNextTime"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                tools:text="11:15 AM – 12:45 PM"
                                android:textColor="#94A3B8"
                                android:textSize="13sp"/>
                        </LinearLayout>

                        <!-- Right White Vertical Room Card -->
                        <com.google.android.material.card.MaterialCardView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:cardBackgroundColor="#FFFFFF"
                            app:cardCornerRadius="16dp"
                            app:cardElevation="4dp"
                            app:strokeWidth="0dp">

                            <LinearLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:orientation="vertical"
                                android:gravity="center"
                                android:paddingHorizontal="16dp"
                                android:paddingVertical="12dp">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="ROOM"
                                    android:textColor="#3B82F6"
                                    android:textSize="11sp"
                                    android:textStyle="bold"
                                    android:letterSpacing="0.05"/>

                                <TextView
                                    android:id="@+id/tvUpNextRoom"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    tools:text="2517"
                                    android:textColor="#0F172A"
                                    android:textSize="20sp"
                                    android:textStyle="bold"/>
                            </LinearLayout>
                        </com.google.android.material.card.MaterialCardView>

                    </LinearLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Date Bar Header Row ("This week • 10–16 Oct" + Nav Arrows) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvThisWeekHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="This week • 10–16 Oct"
                    android:textColor="#FFFFFF"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:gravity="center"/>

                <TextView
                    android:id="@+id/btnPrevWeek"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="‹"
                    android:textColor="#94A3B8"
                    android:textSize="22sp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"/>

                <TextView
                    android:id="@+id/btnNextWeek"
                    android:layout_width="32dp"
                    android:layout_height="32dp"
                    android:text="›"
                    android:textColor="#94A3B8"
                    android:textSize="22sp"
                    android:gravity="center"
                    android:clickable="true"
                    android:focusable="true"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:layout_marginStart="4dp"/>
            </LinearLayout>

            <!-- Equally-spaced Horizontal 7-Day Pill Selector (SAT-FRI) -->
            <LinearLayout
                android:id="@+id/containerDayPicker"
                android:layout_width="match_parent"
                android:layout_height="64dp"
                android:orientation="horizontal"
                android:weightSum="7"
                android:paddingHorizontal="2dp"
                android:layout_marginBottom="20dp">
                <!-- Day pill views populated dynamically in code -->
            </LinearLayout>

            <!-- Section Title Header for Daily Routine / Today -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="14dp"
                android:layout_marginStart="2dp">

                <TextView
                    android:id="@+id/tvDailyRoutineTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Today"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold"/>

                <TextView
                    android:id="@+id/tvClassSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="4 classes • 11:15 AM – 5:45 PM"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginStart="10dp"/>
            </LinearLayout>

            <!-- RecyclerView Timeline for Daily Classes -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerViewRoutine"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"/>

            <!-- Modern Empty State Container View when no classes for selected day -->
            <LinearLayout
                android:id="@+id/layoutEmptyState"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:paddingHorizontal="24dp"
                android:paddingVertical="36dp"
                android:visibility="gone"
                tools:visibility="visible">

                <!-- Icon Container Badge -->
                <FrameLayout
                    android:layout_width="72dp"
                    android:layout_height="72dp"
                    android:background="@drawable/glass_badge_bg"
                    android:backgroundTint="#1E1B4B"
                    android:layout_marginBottom="16dp">

                    <ImageView
                        android:layout_width="36dp"
                        android:layout_height="36dp"
                        android:layout_gravity="center"
                        android:src="@drawable/ic_calendar"
                        app:tint="#0066FF"
                        tools:ignore="ContentDescription"/>
                </FrameLayout>

                <!-- Dynamic Title: "Nothing on Friday" -->
                <TextView
                    android:id="@+id/tvEmptyStateTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="Nothing on Friday"
                    android:textColor="#FFFFFF"
                    android:textSize="20sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="8dp"/>

                <!-- Subtitle -->
                <TextView
                    android:id="@+id/tvEmptyStateSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Swipe or tap another day, or use the arrows for other weeks."
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:gravity="center"
                    android:lineSpacingExtra="2dp"
                    android:layout_marginBottom="24dp"/>

                <!-- Action Button: "+ Add a class on Fri" -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddClassEmptyState"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    tools:text="+ Add a class on Fri"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:cornerRadius="24dp"
                    app:backgroundTint="#0066FF"
                    android:paddingHorizontal="24dp"
                    app:elevation="4dp"/>

                <!-- Backward compatibility hidden reference -->
                <TextView
                    android:id="@+id/tvNoRoutineClasses"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:visibility="gone"/>

            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <!-- Floating Action Button for CR / Teacher -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabAddRoutineClass"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="20dp"
        android:contentDescription="Add Class"
        android:src="@android:drawable/ic_input_add"
        app:backgroundTint="#0066FF"
        app:tint="#FFFFFF"
        app:layout_constraintBottom_toTopOf="@id/bottomNavRoutine"
        app:layout_constraintEnd_toEndOf="parent"
        android:visibility="gone"/>

    <!-- Persistent Bottom Navigation Bar -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNavRoutine"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:hapticFeedbackEnabled="true"
        android:background="@color/surface"
        app:itemIconTint="@color/bottom_nav_item_color"
        app:itemTextColor="@color/bottom_nav_item_color"
        app:itemRippleColor="@color/card_stroke"
        app:itemActiveIndicatorStyle="@style/App.CustomActiveIndicator"
        app:labelVisibilityMode="labeled"
        app:itemIconSize="22dp"
        app:elevation="12dp"
        app:menu="@menu/bottom_nav_menu_student"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>

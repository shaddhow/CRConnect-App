<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/layoutProfileSection"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:paddingBottom="24dp"
    android:fillViewport="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingTop="4dp">

        <!-- Top Profile Card: Compact & Sleek -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="18dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/glass_card"
            app:strokeWidth="1.5dp"
            app:strokeColor="#30FFFFFF"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="14dp"
                android:gravity="center_horizontal">

                <!-- Compact Avatar -->
                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/imgProfileAvatar"
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:scaleType="centerCrop"
                    android:src="@drawable/bubt_logo"
                    app:shapeAppearanceOverlay="@style/ShapeAppearance.App.Circular"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="2dp"
                    android:layout_marginBottom="8dp"
                    tools:ignore="ContentDescription" />

                <TextView
                    android:id="@+id/tvProfileName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Developer Student"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="2dp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvProfileEmail"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="student@bubt.edu.bd"
                    android:textSize="12sp"
                    android:textColor="#94A3B8"
                    android:layout_marginBottom="8dp"
                    tools:ignore="HardcodedText" />

                <TextView
                    android:id="@+id/tvProfileDept"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Department of CSE, BUBT"
                    android:textSize="11sp"
                    android:textColor="@color/secondary"
                    android:textStyle="bold"
                    android:background="@drawable/glass_badge_bg"
                    android:paddingHorizontal="10dp"
                    android:paddingVertical="4dp"
                    android:layout_marginBottom="12dp"
                    tools:ignore="HardcodedText" />

                <!-- Slimmer Stat Capsules Row using Symmetric Horizontal Chain Style Spread -->
                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:id="@+id/cardIdContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/glass_card_bg"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="4dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintEnd_toStartOf="@id/cardIntakeContainer"
                        app:layout_constraintHorizontal_chainStyle="spread">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="STUDENT ID" android:textSize="11sp" android:textColor="#9CA3AF" android:textStyle="bold" tools:ignore="HardcodedText"/>
                        <TextView android:id="@+id/tvProfileStudentID" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2023-DEV-001" android:textSize="13sp" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="2dp" android:singleLine="true" tools:ignore="HardcodedText"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardIntakeContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/glass_card_bg"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="4dp"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="8dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cardIdContainer"
                        app:layout_constraintEnd_toStartOf="@id/cardSectionContainer">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="INTAKE" android:textSize="11sp" android:textColor="#9CA3AF" android:textStyle="bold" tools:ignore="HardcodedText"/>
                        <TextView android:id="@+id/tvProfileIntake" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="55" android:textSize="13sp" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="2dp" tools:ignore="HardcodedText"/>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/cardSectionContainer"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:background="@drawable/glass_card_bg"
                        android:paddingVertical="8dp"
                        android:paddingHorizontal="4dp"
                        app:layout_constraintTop_toTopOf="parent"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cardIntakeContainer"
                        app:layout_constraintEnd_toEndOf="parent">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="SECTION" android:textSize="11sp" android:textColor="#9CA3AF" android:textStyle="bold" tools:ignore="HardcodedText"/>
                        <TextView android:id="@+id/tvProfileSection" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="55/8" android:textSize="13sp" android:textColor="#FFFFFF" android:textStyle="bold" android:layout_marginTop="2dp" tools:ignore="HardcodedText"/>
                    </LinearLayout>

                </androidx.constraintlayout.widget.ConstraintLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Academic Status Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/glass_card"
            app:strokeWidth="1.5dp"
            app:strokeColor="#30FFFFFF"
            android:layout_marginBottom="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Academic Status"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="10dp"
                    tools:ignore="HardcodedText"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Verification Status" android:textColor="#94A3B8" android:textSize="13sp" tools:ignore="HardcodedText"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Verified • Locked" android:textColor="#10B981" android:textSize="12sp" android:textStyle="bold" android:background="@drawable/glass_badge_bg" android:paddingHorizontal="10dp" android:paddingVertical="4dp" tools:ignore="HardcodedText"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="8dp">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Total Enrolled Courses" android:textColor="#94A3B8" android:textSize="13sp" tools:ignore="HardcodedText"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="6 Courses" android:textColor="#FFFFFF" android:textSize="13sp" android:textStyle="bold" tools:ignore="HardcodedText"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">
                    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Attendance Overview" android:textColor="#94A3B8" android:textSize="13sp" tools:ignore="HardcodedText"/>
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="92% (Excellent)" android:textColor="#38BDF8" android:textSize="13sp" android:textStyle="bold" tools:ignore="HardcodedText"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Quick Settings / Action Chips -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@color/glass_card"
            app:strokeWidth="1.5dp"
            app:strokeColor="#30FFFFFF"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Quick Actions"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="4dp"
                    tools:ignore="HardcodedText"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnEditProfile"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Edit Profile Picture"
                    android:textColor="#38BDF8"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:strokeColor="#38BDF8"
                    app:strokeWidth="1dp"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="8dp"
                    tools:ignore="HardcodedText"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnSecuritySettings"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Security Settings"
                    android:textColor="#A78BFA"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:strokeColor="#A78BFA"
                    app:strokeWidth="1dp"
                    app:backgroundTint="@android:color/transparent"
                    app:cornerRadius="12dp"
                    android:layout_marginBottom="8dp"
                    tools:ignore="HardcodedText"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnProfileLogout"
                    style="@style/Widget.Material3.Button.ElevatedButton"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:text="Log Out"
                    android:textColor="#FFFFFF"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:backgroundTint="#EF4444"
                    app:cornerRadius="12dp"
                    tools:ignore="HardcodedText"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

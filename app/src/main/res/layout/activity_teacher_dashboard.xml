<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollViewAdmin"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_gradient">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="16dp">

        <include layout="@layout/include_header" />

        <!-- Live Statistics Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="32dp"
            app:cardElevation="20dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#D9171F2F"
            app:strokeWidth="1.5dp"
            app:strokeColor="#334155">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:baselineAligned="false"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📊 Live Election Statistics"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false"
                    android:weightSum="3">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvStatTotalVotes"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#38BDF8"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Votes Cast"
                            android:textSize="12sp"
                            android:textColor="#94A3B8"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvStatTotalVoters"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#10B981"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Voters"
                            android:textSize="12sp"
                            android:textColor="#94A3B8"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:gravity="center">
                        <TextView
                            android:id="@+id/tvStatTurnout"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="0%"
                            android:textSize="22sp"
                            android:textStyle="bold"
                            android:textColor="#F59E0B"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Turnout"
                            android:textSize="12sp"
                            android:textColor="#94A3B8"
                            android:layout_marginTop="4dp"/>
                    </LinearLayout>
                </LinearLayout>

                <!-- Export Results to PDF Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnExportPdf"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="📄 Export Results to PDF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#F8FAFC"
                    app:backgroundTint="#0284C7"
                    app:cornerRadius="16dp"
                    android:layout_marginTop="20dp"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Voting Gate Control (Dark Glassmorphism) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="32dp"
            app:cardElevation="20dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#D9171F2F"
            app:strokeWidth="1.5dp"
            app:strokeColor="#334155">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:padding="24dp"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Live Voting Gate"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#F8FAFC"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Control student access instantly"
                        android:textSize="13sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/switchMasterVoting"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:trackTint="#10B981"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Add Candidate Section -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="32dp"
            app:cardElevation="20dp"
            android:layout_marginBottom="24dp"
            app:cardBackgroundColor="#D9171F2F"
            app:strokeWidth="1.5dp"
            app:strokeColor="#334155">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="28dp">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="New Candidate"
                        android:textSize="18sp"
                        android:textStyle="bold"
                        android:textColor="#F8FAFC"/>

                    <TextView
                        android:id="@+id/tvTotalCandidates"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:text="Total: 0"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:textColor="#38BDF8"
                        android:background="#2E374A"
                        android:paddingHorizontal="14dp"
                        android:paddingVertical="6dp"/>
                </RelativeLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    android:layout_marginBottom="20dp"
                    app:boxCornerRadiusTopStart="16dp" app:boxCornerRadiusTopEnd="16dp"
                    app:boxCornerRadiusBottomStart="16dp" app:boxCornerRadiusBottomEnd="16dp"
                    app:boxStrokeColor="#10B981"
                    app:hintTextColor="#64748B"
                    android:textColorHint="#94A3B8">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etCandidateName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Full Name"
                        android:textColor="#FFFFFF"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnAddCandidate"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Publish to Dashboard"
                    android:textStyle="bold"
                    app:backgroundTint="#10B981"
                    app:cornerRadius="16dp"/>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnClearName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Reset Input"
                    style="@style/Widget.Material3.Button.TextButton"
                    android:layout_marginTop="8dp"
                    android:textColor="#94A3B8"/>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Advanced Controls -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="32dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="#D9171F2F"
            app:strokeWidth="1.5dp"
            app:strokeColor="#334155"
            android:layout_marginBottom="28dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Advanced Controls"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:textColor="#94A3B8"
                    android:layout_marginBottom="16dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:baselineAligned="false">

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnRunOff"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Run-off"
                        android:layout_marginEnd="8dp"
                        app:backgroundTint="#8B5CF6"
                        app:cornerRadius="16dp"/>

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnResetVotes"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Reset All"
                        app:backgroundTint="#EF4444"
                        app:cornerRadius="16dp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Candidate List Container -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="40dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Published Candidates"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="#F8FAFC"
                android:layout_marginBottom="16dp"
                android:layout_marginStart="4dp"/>

            <LinearLayout
                android:id="@+id/containerAdminCandidates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"/>
        </LinearLayout>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>

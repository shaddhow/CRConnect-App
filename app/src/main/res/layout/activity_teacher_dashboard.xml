<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawerLayoutTeacher"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient"
    tools:context=".TeacherDashboardActivity">

    <!-- Main Content Container with ConstraintLayout -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/layoutMainContent"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/bg_gradient">

        <!-- Top Fixed Header Outside Scroll Area -->
        <include
            android:id="@+id/includeHeader"
            layout="@layout/include_header"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:paddingHorizontal="20dp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Bottom Fixed Navigation Bar -->
        <com.google.android.material.bottomnavigation.BottomNavigationView
            android:id="@+id/bottomNavTeacher"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:hapticFeedbackEnabled="true"
            android:background="@drawable/bg_bottom_nav"
            app:itemIconTint="@color/bottom_nav_item_color"
            app:itemTextColor="@color/bottom_nav_item_color"
            app:itemRippleColor="@color/tint"
            app:itemActiveIndicatorStyle="@style/App.CustomActiveIndicator"
            app:labelVisibilityMode="labeled"
            app:itemIconSize="22dp"
            app:elevation="8dp"
            app:menu="@menu/bottom_nav_menu_teacher"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- NestedScrollView constrained between Header and BottomNav -->
        <androidx.core.widget.NestedScrollView
            android:id="@+id/scrollViewAdmin"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:fillViewport="true"
            android:clipToPadding="false"
            app:layout_constraintTop_toBottomOf="@id/includeHeader"
            app:layout_constraintBottom_toTopOf="@id/bottomNavTeacher"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <LinearLayout
                android:id="@+id/containerHeaderAndBody"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="20dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false">

                <!-- Live Statistics Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardLiveStats"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hapticFeedbackEnabled="true"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp"
                    android:outlineAmbientShadowColor="#14000000"
                    android:outlineSpotShadowColor="#14000000"
                    tools:ignore="UnusedAttribute">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:baselineAligned="false"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="16dp"
                            android:gravity="center_vertical"
                            android:orientation="horizontal">

                            <!-- Icon Badge Container -->
                            <FrameLayout
                                android:layout_width="40dp"
                                android:layout_height="40dp"
                                android:background="@drawable/bg_icon_badge"
                                android:layout_marginEnd="10dp">
                                <ImageView
                                    android:layout_width="20dp"
                                    android:layout_height="20dp"
                                    android:layout_gravity="center"
                                    android:src="@drawable/ic_nav_stats"
                                    app:tint="#0066FF"
                                    tools:ignore="ContentDescription" />
                            </FrameLayout>

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Live election statistics"
                                android:textColor="#0F172A"
                                android:textSize="16sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal"
                            android:paddingVertical="8dp"
                            android:weightSum="3">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvStatTotalVotes"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="#0066FF"
                                    android:textSize="26sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Votes cast"
                                    android:textColor="#64748B"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvStatTotalVoters"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0"
                                    android:textColor="#0F172A"
                                    android:textSize="26sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Voters"
                                    android:textColor="#64748B"
                                    android:textSize="12sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical">

                                <TextView
                                    android:id="@+id/tvStatTurnout"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="0%"
                                    android:textColor="#0066FF"
                                    android:textSize="26sp"
                                    android:textStyle="bold" />

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="2dp"
                                    android:text="Turnout"
                                    android:textColor="#64748B"
                                    android:textSize="12sp" />
                            </LinearLayout>
                        </LinearLayout>

                        <!-- Export Results to PDF Button -->
                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnExportPdf"
                            android:layout_width="match_parent"
                            android:layout_height="48dp"
                            android:layout_marginTop="16dp"
                            android:hapticFeedbackEnabled="true"
                            android:paddingHorizontal="16dp"
                            android:text="Export results to PDF"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/primary"
                            app:cornerRadius="12dp"
                            android:insetBottom="0dp"
                            android:insetTop="0dp" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Voting Gate Control Card -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardVotingGate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hapticFeedbackEnabled="true"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp"
                    android:outlineAmbientShadowColor="#14000000"
                    android:outlineSpotShadowColor="#14000000"
                    tools:ignore="UnusedAttribute">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="20dp">

                        <!-- Icon Badge Container -->
                        <FrameLayout
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:background="@drawable/bg_icon_badge"
                            android:layout_marginEnd="12dp">
                            <ImageView
                                android:layout_width="20dp"
                                android:layout_height="20dp"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_nav_home"
                                app:tint="#0066FF"
                                tools:ignore="ContentDescription" />
                        </FrameLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Live voting gate"
                                android:textColor="#0F172A"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:text="Control student access instantly"
                                android:textColor="#64748B"
                                android:textSize="13sp" />
                        </LinearLayout>

                        <com.google.android.material.materialswitch.MaterialSwitch
                            android:id="@+id/switchMasterVoting"
                            android:layout_width="56dp"
                            android:layout_height="32dp"
                            android:hapticFeedbackEnabled="true"
                            app:trackTint="@color/switch_track_selector"
                            app:thumbTint="@color/switch_thumb_selector"
                            app:thumbIcon="@null"
                            app:trackDecorationTint="@android:color/transparent" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Live Election Control & Timer Card -->
                <include layout="@layout/teacher_dashboard_control" />

                <!-- Add Candidate Section -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAddCandidate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="16dp"
                    android:hapticFeedbackEnabled="true"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp"
                    android:outlineAmbientShadowColor="#14000000"
                    android:outlineSpotShadowColor="#14000000"
                    tools:ignore="UnusedAttribute">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="New candidate"
                                android:textColor="#0F172A"
                                android:textSize="16sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/tvTotalCandidates"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:background="@drawable/bg_chip_muted"
                                android:paddingHorizontal="10dp"
                                android:paddingVertical="4dp"
                                android:text="Total (Sec 6): 0"
                                android:textColor="#64748B"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </RelativeLayout>

                        <com.google.android.material.textfield.TextInputLayout
                            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:textColorHint="#64748B"
                            app:boxBackgroundColor="#FFFFFF"
                            app:boxCornerRadiusBottomEnd="12dp"
                            app:boxCornerRadiusBottomStart="12dp"
                            app:boxCornerRadiusTopEnd="12dp"
                            app:boxCornerRadiusTopStart="12dp"
                            app:boxStrokeColor="@color/primary"
                            app:startIconDrawable="@drawable/ic_user"
                            app:startIconTint="#94A3B8"
                            app:hintTextColor="@color/primary">

                            <com.google.android.material.textfield.TextInputEditText
                                android:id="@+id/etCandidateName"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:hint="Full name"
                                android:textColor="#0F172A" />
                        </com.google.android.material.textfield.TextInputLayout>

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnAddCandidate"
                            android:layout_width="match_parent"
                            android:layout_height="52dp"
                            android:hapticFeedbackEnabled="true"
                            android:paddingHorizontal="16dp"
                            android:text="Publish to dashboard"
                            android:textAllCaps="false"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"
                            android:textStyle="bold"
                            app:backgroundTint="@color/primary"
                            app:cornerRadius="12dp"
                            android:insetBottom="0dp"
                            android:insetTop="0dp" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/btnClearName"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:hapticFeedbackEnabled="true"
                            android:text="Reset input"
                            android:textAllCaps="false"
                            android:textColor="#0066FF"
                            android:textSize="14sp"
                            android:textStyle="bold" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Advanced Controls -->
                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardAdvancedControls"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="20dp"
                    android:hapticFeedbackEnabled="true"
                    app:cardBackgroundColor="#FFFFFF"
                    app:cardCornerRadius="20dp"
                    app:cardElevation="2dp"
                    app:strokeColor="#E2E8F0"
                    app:strokeWidth="1dp"
                    android:outlineAmbientShadowColor="#14000000"
                    android:outlineSpotShadowColor="#14000000"
                    tools:ignore="UnusedAttribute">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="20dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginBottom="12dp"
                            android:text="Advanced controls"
                            android:textColor="#64748B"
                            android:textSize="13sp"
                            android:textStyle="bold" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:baselineAligned="false"
                            android:orientation="horizontal"
                            android:weightSum="2">

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnRunOff"
                                style="@style/Widget.Material3.Button.OutlinedButton"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_marginEnd="6dp"
                                android:layout_weight="1"
                                android:hapticFeedbackEnabled="true"
                                android:paddingHorizontal="12dp"
                                android:text="Run-off"
                                android:textAllCaps="false"
                                android:textColor="#0066FF"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:strokeColor="#0066FF"
                                app:strokeWidth="1.5dp"
                                app:backgroundTint="#FFFFFF"
                                app:cornerRadius="12dp"
                                android:insetBottom="0dp"
                                android:insetTop="0dp" />

                            <com.google.android.material.button.MaterialButton
                                android:id="@+id/btnResetVotes"
                                android:layout_width="0dp"
                                android:layout_height="48dp"
                                android:layout_weight="1"
                                android:hapticFeedbackEnabled="true"
                                android:paddingHorizontal="12dp"
                                android:text="Reset all"
                                android:textAllCaps="false"
                                android:textColor="#B91C1C"
                                android:textSize="14sp"
                                android:textStyle="bold"
                                app:strokeColor="#FECACA"
                                app:strokeWidth="1.5dp"
                                app:backgroundTint="#FEF2F2"
                                app:cornerRadius="12dp"
                                android:insetBottom="0dp"
                                android:insetTop="0dp" />
                        </LinearLayout>
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <!-- Published Candidates Section -->
                <LinearLayout
                    android:id="@+id/sectionPublishedCandidates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="24dp">

                    <TextView
                        android:id="@+id/tvPublishedCandidatesHeader"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="4dp"
                        android:layout_marginBottom="12dp"
                        android:text="Published candidates"
                        android:textColor="#0F172A"
                        android:textSize="18sp"
                        android:textStyle="bold" />

                    <!-- Live Vote Distribution Chart Container -->
                    <LinearLayout
                        android:id="@+id/containerChart"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />

                    <!-- Candidate List RecyclerView -->
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rvAdminCandidates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        tools:listitem="@layout/list_item_candidate" />

                    <!-- Legacy Fallback Container -->
                    <LinearLayout
                        android:id="@+id/containerAdminCandidates"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone" />
                </LinearLayout>

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>

    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Navigation Drawer -->
    <com.google.android.material.navigation.NavigationView
        android:id="@+id/navViewTeacher"
        android:layout_width="300dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_drawer"
        app:headerLayout="@layout/nav_header"
        app:menu="@menu/drawer_menu_teacher"
        app:itemIconTint="#0066FF"
        app:itemTextColor="#0F172A" />

</androidx.drawerlayout.widget.DrawerLayout>

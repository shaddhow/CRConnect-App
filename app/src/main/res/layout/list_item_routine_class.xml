<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:layout_marginBottom="12dp">

    <!-- Timeline Left Column: Time & Node Line -->
    <LinearLayout
        android:layout_width="68dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center_horizontal"
        android:paddingTop="12dp">

        <TextView
            android:id="@+id/tvTimelineTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="09:00 AM"
            android:textColor="#A78BFA"
            android:textSize="11sp"
            android:textStyle="bold"/>

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:layout_marginTop="6dp"
            android:background="@drawable/glass_badge_bg"
            android:backgroundTint="#7C3AED"/>

        <View
            android:layout_width="2dp"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="4dp"
            android:background="#222938"/>
    </LinearLayout>

    <!-- Timeline Right Column: Class Card -->
    <com.google.android.material.card.MaterialCardView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        app:cardBackgroundColor="#121622"
        app:cardCornerRadius="16dp"
        app:cardElevation="3dp"
        app:strokeColor="#222938"
        app:strokeWidth="1.5dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Top Row: Course Code + Room Badge -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginBottom="8dp">

                <!-- Bold Course Code -->
                <TextView
                    android:id="@+id/tvRoutineSubject"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="CSE 341"
                    android:textColor="#FFFFFF"
                    android:textSize="16sp"
                    android:textStyle="bold"/>

                <!-- Room Badge -->
                <TextView
                    android:id="@+id/tvRoutineRoom"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="2808"
                    android:textColor="#A5B4FC"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:background="@drawable/glass_badge_bg"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"/>

                <!-- Delete Action for CR/Teacher -->
                <ImageView
                    android:id="@+id/btnDeleteRoutine"
                    android:layout_width="24dp"
                    android:layout_height="24dp"
                    android:src="@android:drawable/ic_menu_delete"
                    app:tint="#EF4444"
                    android:layout_marginStart="8dp"
                    android:clickable="true"
                    android:focusable="true"
                    android:visibility="gone"
                    tools:ignore="ContentDescription"/>
            </LinearLayout>

            <!-- Bottom Row: Faculty + Duration + Time Slot -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <!-- Faculty / Instructor -->
                <TextView
                    android:id="@+id/tvRoutineTeacher"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="FC: AAG"
                    android:textColor="#94A3B8"
                    android:textSize="12sp"/>

                <!-- Duration -->
                <TextView
                    android:id="@+id/tvRoutineDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="1h 30m"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"/>

                <!-- Hidden full time slot for reference -->
                <TextView
                    android:id="@+id/tvRoutineTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="09:00 AM - 10:30 AM"
                    android:textColor="#64748B"
                    android:textSize="11sp"
                    android:visibility="gone"/>
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</LinearLayout>
<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <!-- Class Card Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <!-- Timeline Left Column: Time & Node Line -->
        <LinearLayout
            android:layout_width="68dp"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingTop="14dp">

            <TextView
                android:id="@+id/tvTimelineTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                tools:text="11:15\nAM"
                android:textColor="#0066FF"
                android:textSize="12sp"
                android:textStyle="bold"
                android:gravity="center"/>

            <View
                android:layout_width="8dp"
                android:layout_height="8dp"
                android:layout_marginTop="6dp"
                android:background="@drawable/glass_badge_bg"
                android:backgroundTint="#0066FF"/>

            <View
                android:layout_width="2dp"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:layout_marginTop="4dp"
                android:background="#222938"/>
        </LinearLayout>

        <!-- Timeline Right Column: Dark Blue Class Card with Accent Left Border -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            app:cardBackgroundColor="#121622"
            app:cardCornerRadius="16dp"
            app:cardElevation="3dp"
            app:strokeColor="#30FFFFFF"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <!-- Top Row: Course Code + Optional Delete Action -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="4dp">

                    <!-- Bold Course Code -->
                    <TextView
                        android:id="@+id/tvRoutineSubject"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        tools:text="CSE 208"
                        android:textColor="#FFFFFF"
                        android:textSize="18sp"
                        android:textStyle="bold"/>

                    <!-- Delete Action for CR/Teacher -->
                    <ImageView
                        android:id="@+id/btnDeleteRoutine"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_menu_delete"
                        app:tint="#EF4444"
                        android:layout_marginStart="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        android:visibility="gone"
                        tools:ignore="ContentDescription"/>
                </LinearLayout>

                <!-- Faculty / Instructor -->
                <TextView
                    android:id="@+id/tvRoutineTeacher"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    tools:text="FC: AAG"
                    android:textColor="#94A3B8"
                    android:textSize="13sp"
                    android:layout_marginBottom="12dp"/>

                <!-- Bottom Row: Two Pure Glassmorphism Badges (Room + Duration) -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- Glass Badge 1: Room Number -->
                    <TextView
                        android:id="@+id/tvRoutineRoom"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="ROOM 2517"
                        android:textColor="#E2E8F0"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/glass_badge_bg"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"
                        android:layout_marginEnd="8dp"/>

                    <!-- Glass Badge 2: Class Duration -->
                    <TextView
                        android:id="@+id/tvRoutineDuration"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="1h 30m"
                        android:textColor="#CBD5E1"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:background="@drawable/glass_badge_bg"
                        android:paddingHorizontal="12dp"
                        android:paddingVertical="6dp"/>

                    <!-- Hidden full time slot for reference -->
                    <TextView
                        android:id="@+id/tvRoutineTime"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        tools:text="11:15 AM - 12:45 PM"
                        android:textColor="#64748B"
                        android:textSize="11sp"
                        android:visibility="gone"/>
                </LinearLayout>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>

    <!-- Optional Timeline Break Divider View -->
    <LinearLayout
        android:id="@+id/layoutTimelineBreak"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="68dp"
        android:paddingEnd="16dp"
        android:paddingVertical="8dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tvBreakDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            tools:text="30 min break"
            android:textColor="#94A3B8"
            android:textSize="12sp"
            android:layout_marginEnd="12dp"/>

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1"
            android:background="#222938"/>
    </LinearLayout>

</LinearLayout>
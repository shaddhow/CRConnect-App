<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollViewRegister"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/bg_gradient"
    tools:context=".RegisterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingVertical="36dp">

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#F8FAFC"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Join CRConnect Network"
            android:textSize="14sp"
            android:textColor="#94A3B8"
            android:layout_marginBottom="20dp"
            android:layout_marginTop="4dp"/>

        <!-- Register Card (Figma Dark Glassmorphism) -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="32dp"
            app:cardElevation="24dp"
            app:cardBackgroundColor="#E61E293B"
            app:strokeWidth="1.5dp"
            app:strokeColor="#334155">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="24dp">

                <RadioGroup
                    android:id="@+id/radioGroupRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="20dp">

                    <RadioButton
                        android:id="@+id/rbStudent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Student"
                        android:checked="true"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#F8FAFC"
                        android:buttonTint="#6366F1"
                        android:layout_marginEnd="32dp"/>

                    <RadioButton
                        android:id="@+id/rbTeacher"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Teacher / Admin"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#F8FAFC"
                        android:buttonTint="#6366F1"/>
                </RadioGroup>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="#6366F1"
                    app:hintTextColor="#6366F1"
                    android:textColorHint="#94A3B8">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Full Name"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="#6366F1"
                    app:hintTextColor="#6366F1"
                    android:textColorHint="#94A3B8">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="BUBT Email (e.g., @cse.bubt.edu.bd)"
                        android:inputType="textEmailAddress"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="#6366F1"
                    app:hintTextColor="#6366F1"
                    android:textColorHint="#94A3B8">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etIdCode"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Student ID / Teacher Code"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- New Profile Fields -->
                <LinearLayout
                    android:id="@+id/layoutStudentFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="#6366F1"
                        app:hintTextColor="#6366F1"
                        android:textColorHint="#94A3B8">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etSection"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Section (e.g., 55/8)"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="#6366F1"
                        app:hintTextColor="#6366F1"
                        android:textColorHint="#94A3B8">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etIntake"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Intake (e.g., 55)"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="12dp"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp"
                        app:boxStrokeColor="#6366F1"
                        app:hintTextColor="#6366F1"
                        android:textColorHint="#94A3B8">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etDept"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Department (e.g., CSE)"
                            android:textColor="#FFFFFF"
                            android:textSize="15sp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="18dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp"
                    app:boxStrokeColor="#6366F1"
                    app:hintTextColor="#6366F1"
                    android:textColorHint="#94A3B8"
                    app:endIconMode="password_toggle" app:endIconTint="#94A3B8">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Create Password"
                        android:inputType="textPassword"
                        android:textColor="#FFFFFF"
                        android:textSize="15sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="54dp"
                    android:text="REGISTER"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#6366F1"
                    app:cornerRadius="16dp"
                    android:layout_marginBottom="14dp"/>

                <TextView
                    android:id="@+id/tvLoginLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? Sign In"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="#06B6D4"
                    android:gravity="center"
                    android:padding="8dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1" />

    </LinearLayout>
</ScrollView>

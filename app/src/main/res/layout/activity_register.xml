<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/scrollViewRegister"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:clipToPadding="false"
    android:background="@color/background"
    tools:context=".RegisterActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:clipToPadding="false"
        android:paddingHorizontal="24dp"
        android:paddingTop="36dp"
        android:paddingBottom="120dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Create Account"
            android:textSize="28sp"
            android:textStyle="bold"
            android:textColor="#FAFAFA"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Join CRConnect Network"
            android:textSize="14sp"
            android:textColor="#94A3B8"
            android:layout_marginBottom="24dp"
            android:layout_marginTop="4dp"/>

        <!-- Register Card (Deep Dark Minimalist Surface) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutFormCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="1.5dp"
            app:strokeColor="@color/card_stroke"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:clipToPadding="false"
                android:padding="24dp">

                <RadioGroup
                    android:id="@+id/radioGroupRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center"
                    android:layout_marginBottom="8dp">

                    <RadioButton
                        android:id="@+id/rbStudent"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Student"
                        android:checked="true"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FAFAFA"
                        android:buttonTint="@color/primary"
                        android:layout_marginEnd="32dp"/>

                    <RadioButton
                        android:id="@+id/rbTeacher"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Teacher / Admin"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:textColor="#FAFAFA"
                        android:buttonTint="@color/primary"/>
                </RadioGroup>

                <!-- Document Scanner Button -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnScanIdCard"
                    android:layout_width="match_parent"
                    android:layout_height="50dp"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="8dp"
                    android:text="Scan BUBT ID Card"
                    android:textAllCaps="false"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    app:backgroundTint="#4C3E72"
                    app:cornerRadius="14dp"
                    app:strokeColor="@color/primary"
                    app:strokeWidth="1.5dp" />

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="4dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxBackgroundColor="@color/input_bg"
                    app:boxStrokeColor="@color/primary"
                    app:hintTextColor="@color/primary"
                    android:textColorHint="#94A3B8"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etFullName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Full Name"
                        android:textColor="#FAFAFA"
                        android:textSize="15sp"
                        android:inputType="textPersonName|textCapWords"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/tilRegEmail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="4dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxBackgroundColor="@color/input_bg"
                    app:boxStrokeColor="@color/primary"
                    app:hintTextColor="@color/primary"
                    android:textColorHint="#94A3B8"
                    android:hint="Student Email"
                    app:helperText="e.g., name@gmail.com"
                    app:helperTextTextColor="#94A3B8"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegEmail"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:textColor="#FAFAFA"
                        android:textSize="15sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <!-- Student Specific Fields Container -->
                <LinearLayout
                    android:id="@+id/layoutStudentFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary"
                        android:textColorHint="#94A3B8"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etStudentId"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Student ID"
                            android:textColor="#FAFAFA"
                            android:textSize="15sp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Section"
                        android:textSize="13sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/dark_edit_text_bg"
                        android:layout_marginBottom="4dp"
                        android:paddingHorizontal="8dp">

                        <Spinner
                            android:id="@+id/spinnerStudentSection"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:spinnerMode="dropdown"
                            android:popupBackground="@drawable/spinner_popup_bg"
                            android:dropDownHeight="240dp"
                            android:dropDownVerticalOffset="4dp"/>
                    </FrameLayout>

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary"
                        android:textColorHint="#94A3B8"
                        app:helperText="e.g., 55"
                        app:helperTextTextColor="#94A3B8"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etIntake"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Intake"
                            android:textColor="#FAFAFA"
                            android:textSize="15sp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Department"
                        android:textSize="13sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/dark_edit_text_bg"
                        android:layout_marginBottom="4dp"
                        android:paddingHorizontal="8dp">

                        <Spinner
                            android:id="@+id/spinnerDept"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:spinnerMode="dropdown"
                            android:popupBackground="@drawable/spinner_popup_bg"
                            android:dropDownHeight="240dp"
                            android:dropDownVerticalOffset="4dp"/>
                    </FrameLayout>

                </LinearLayout>

                <!-- Teacher Specific Fields Container -->
                <LinearLayout
                    android:id="@+id/layoutTeacherFields"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <com.google.android.material.textfield.TextInputLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"
                        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                        app:boxBackgroundColor="@color/input_bg"
                        app:boxStrokeColor="@color/primary"
                        app:hintTextColor="@color/primary"
                        android:textColorHint="#94A3B8"
                        app:boxCornerRadiusTopStart="14dp"
                        app:boxCornerRadiusTopEnd="14dp"
                        app:boxCornerRadiusBottomStart="14dp"
                        app:boxCornerRadiusBottomEnd="14dp">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/etTeacherCode"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:hint="Teacher Code / ID"
                            android:textColor="#FAFAFA"
                            android:textSize="15sp"/>
                    </com.google.android.material.textfield.TextInputLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Department"
                        android:textSize="13sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/dark_edit_text_bg"
                        android:layout_marginBottom="4dp"
                        android:paddingHorizontal="8dp">

                        <Spinner
                            android:id="@+id/spinnerTeacherDept"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:spinnerMode="dropdown"
                            android:popupBackground="@drawable/spinner_popup_bg"
                            android:dropDownHeight="240dp"
                            android:dropDownVerticalOffset="4dp"/>
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Assigned Section"
                        android:textSize="13sp"
                        android:textColor="#94A3B8"
                        android:layout_marginTop="12dp"
                        android:layout_marginBottom="4dp"/>

                    <FrameLayout
                        android:layout_width="match_parent"
                        android:layout_height="56dp"
                        android:background="@drawable/dark_edit_text_bg"
                        android:layout_marginBottom="4dp"
                        android:paddingHorizontal="8dp">

                        <Spinner
                            android:id="@+id/spinnerAssignedSection"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@null"
                            android:spinnerMode="dropdown"
                            android:popupBackground="@drawable/spinner_popup_bg"
                            android:dropDownHeight="240dp"
                            android:dropDownVerticalOffset="4dp"/>
                    </FrameLayout>

                </LinearLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:layout_marginBottom="24dp"
                    style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
                    app:boxBackgroundColor="@color/input_bg"
                    app:boxStrokeColor="@color/primary"
                    app:hintTextColor="@color/primary"
                    android:textColorHint="#94A3B8"
                    app:boxCornerRadiusTopStart="14dp"
                    app:boxCornerRadiusTopEnd="14dp"
                    app:boxCornerRadiusBottomStart="14dp"
                    app:boxCornerRadiusBottomEnd="14dp"
                    app:endIconMode="password_toggle"
                    app:endIconTint="#94A3B8">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/etRegPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:hint="Password"
                        android:inputType="textPassword"
                        android:textColor="#FAFAFA"
                        android:textSize="15sp"/>
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRegister"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="REGISTER"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="@color/primary"
                    app:cornerRadius="16dp"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:id="@+id/tvLoginLink"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Already have an account? Sign In"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:textColor="@color/secondary"
                    android:gravity="center"
                    android:padding="8dp"/>

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Success State Card (Initially Gone) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/layoutSuccessCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardElevation="16dp"
            app:cardBackgroundColor="@color/surface"
            app:strokeWidth="1.5dp"
            app:strokeColor="#10B981"
            android:visibility="gone"
            android:layout_marginBottom="24dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:padding="32dp">

                <ImageView
                    android:layout_width="64dp"
                    android:layout_height="64dp"
                    android:src="@drawable/ic_app_main"
                    android:layout_marginBottom="16dp"
                    tools:ignore="ContentDescription,UseAppTint" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Verification Required"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/secondary"
                    android:gravity="center"
                    android:layout_marginBottom="12dp" />

                <TextView
                    android:id="@+id/tvSuccessMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Verification link sent to your email. Please check your inbox and verify your account before logging in."
                    android:textSize="15sp"
                    android:textColor="#CBD5E1"
                    android:gravity="center"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginBottom="28dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnBackToLogin"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="Back to Login"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    app:backgroundTint="#10B981"
                    app:cornerRadius="16dp" />

            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</androidx.core.widget.NestedScrollView>
